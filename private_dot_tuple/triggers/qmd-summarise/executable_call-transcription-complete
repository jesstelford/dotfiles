#!/bin/sh
# Tuple trigger: fires once Tuple has finished transcribing a call.
#
# Deliberately NOT call-ended: that fires while transcription is still being
# written, so the transcript would be partial or empty. Transcription events
# carry no call-specific env vars, so TUPLE_TRIGGER_CALL_ID is normally unset
# here and tuple-postcall-summarise falls back to the newest stored call.
#
# Detaches immediately — summarising runs Claude over the transcript and can
# take minutes, and Tuple should not be held open waiting for it. Output goes
# to ~/.cache/qmd/postcall.log.
PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

LOG="$HOME/.cache/qmd/postcall.log"
mkdir -p "$(dirname "$LOG")"

nohup "$HOME/.local/bin/tuple-postcall-summarise" "${TUPLE_TRIGGER_CALL_ID:-}" \
  >>"$LOG" 2>&1 &

exit 0
