#!/usr/bin/env python3
"""Export Tuple call titles + summaries as small markdown files for qmd.

Deliberately summaries-only: raw transcripts are mostly filler and cross-talk,
and they capture incidental personal conversation. Retrieve verbatim detail on
demand with `tuple transcription show <call-id>`.

Runs from qmd's collection update hook, so it MUST NOT fail: qmd update also
syncs the Logseq notes collection, and a Tuple outage must never block that.
Every failure path leaves any existing output untouched and exits 0.
"""
import json, os, subprocess, sys
from datetime import datetime, timezone

OUT = os.environ.get("TUPLE_QMD_OUT", os.path.expanduser("~/.local/share/tuple-summaries"))
TUPLE = os.environ.get("TUPLE_BIN", "tuple")


def bail(msg):
    print(f"tuple-qmd-summaries: {msg}; leaving existing exports untouched", file=sys.stderr)
    sys.exit(0)


def local(ts):
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None


def render(c):
    cid = c.get("call_id") or ""
    title = (c.get("title") or "").strip()
    summary = (c.get("summary") or "").strip()
    people = ", ".join(p.get("full_name", "") for p in c.get("participants") or []) or "unknown"
    start, end = local(c.get("started_at")), local(c.get("ended_at"))
    when = start.strftime("%Y-%m-%d %H:%M") if start else "unknown"
    if start and end:
        mins = round((end - start).total_seconds() / 60)
        when += f" – {end.strftime('%H:%M')} ({mins}m)"

    fm = {
        "call_id": cid, "title": title or None,
        "started_at": c.get("started_at"), "ended_at": c.get("ended_at"),
        "participants": people, "segments": c.get("segments", 0),
        "summarised": bool(summary), "source": "tuple",
    }
    lines = ["---"]
    lines += [f"{k}: {json.dumps(v)}" for k, v in fm.items() if v is not None]
    lines += ["---", "", f"# {title or f'Untitled call — {when}'}", "",
              f"**When:** {when}", f"**With:** {people}", ""]
    if summary:
        lines += ["## Summary", "", summary, ""]
    else:
        lines += ["_No summary recorded yet._ Add one with",
                  f"`tuple transcription set-summary {cid} \"...\"` and it will be indexed", 
                  "on the next sync.", ""]
    lines += ["## Full transcript", "",
              "Not indexed — retrieve on demand with:", "",
              f"    tuple transcription show {cid}", ""]
    return "\n".join(lines)


def main():
    try:
        p = subprocess.run([TUPLE, "transcription", "list", "--format", "json"],
                           capture_output=True, text=True, timeout=30)
    except FileNotFoundError:
        bail(f"{TUPLE!r} not found on PATH")
    except (subprocess.SubprocessError, OSError) as e:
        bail(f"could not run tuple ({e})")
    if p.returncode != 0:
        bail(f"tuple exited {p.returncode} ({(p.stderr or '').strip()[:120]})")
    try:
        calls = json.loads(p.stdout or "[]")
        if not isinstance(calls, list):
            raise ValueError("expected a JSON array")
    except (ValueError, TypeError) as e:
        bail(f"unparseable tuple output ({e})")

    try:
        os.makedirs(OUT, exist_ok=True)
    except OSError as e:
        bail(f"cannot create {OUT} ({e})")

    wanted, wrote, pruned = {}, 0, 0
    for c in calls:
        if not isinstance(c, dict) or not c.get("call_id"):
            continue
        # Match tuple's own export: skip calls with nothing in them at all.
        if not (c.get("summary") or c.get("title") or c.get("segments")):
            continue
        start = local(c.get("started_at"))
        day = start.strftime("%Y-%m-%d") if start else "undated"
        wanted[f"{day}@{c['call_id']}.md"] = render(c)

    for name, body in wanted.items():
        path = os.path.join(OUT, name)
        try:                                    # write only if changed: no mtime churn
            with open(path) as fh:
                if fh.read() == body:
                    continue
        except OSError:
            pass
        try:
            with open(path, "w") as fh:
                fh.write(body)
            wrote += 1
        except OSError as e:
            print(f"tuple-qmd-summaries: could not write {name} ({e})", file=sys.stderr)

    try:                                        # drop files for deleted calls
        for name in os.listdir(OUT):
            if name.endswith(".md") and name not in wanted:
                os.remove(os.path.join(OUT, name)); pruned += 1
    except OSError:
        pass

    print(f"tuple-qmd-summaries: {len(wanted)} calls ({wrote} written, {pruned} pruned) -> {OUT}")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:                      # never break `qmd update`
        bail(f"unexpected error ({e.__class__.__name__}: {e})")
