#!/usr/bin/env bash
{{- /* Applications: 1Password (desktop and CLI), pdftk, xournal++, Signal,
       PICO-8, Rectangle, AltTab, Karabiner-Elements, LICEcap, Discord, the
       Moonlander tooling, mkcert.

       install_one_password_cli and install_pico8 have to stay in one script,
       in this order: PICO-8 reads its itch.io credentials out of 1Password
       with `op`, and calls install_one_password_cli directly when `op` is
       missing. */}}
{{- /*
  Architecture spellings. .chezmoi.arch is Go's GOARCH — "amd64" or "arm64" on
  every machine this repo targets — and upstreams spell it four different ways:

    $arch      amd64  | arm64     dpkg / .deb assets / Go's own tarballs
    $archnvim  x86_64 | arm64     Neovim release assets
    $archlua   x64    | arm64     lua-language-server release assets
    $archgnu   x86_64 | aarch64   GNU triplet spelling; DBeaver release assets

  Derived per script rather than once globally: a template variable set inside
  an included .chezmoitemplates file is scoped to that template, so it cannot be
  shared the way the shell helpers are. Each script derives only the spellings
  it actually uses.
*/}}
{{- $arch := .chezmoi.arch }}
{{- if eq $arch "amd64" }}
{{- end }}
{{- /*
  Download integrity.

  Every download here arrives over TLS, which authenticates the host and says
  nothing whatsoever about the bytes. So: where a download is pinned to a
  version, the SHA-256 of that exact asset is pinned beside it in
  .chezmoidata.toml and checked with verify_sha256 before anything is
  installed. See that file's header for how to refresh a digest.
*/}}

{{ template "setup-helpers.sh.tmpl" . }}

{{- if .islocalenv }}
# 1password
install_one_password_desktop() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    use_temp_dir
    wget --no-verbose https://downloads.1password.com/mac/1Password.zip
    # -o: an unzip overwrite prompt has nowhere to be answered — chezmoi passes
    # this script's stdin straight through, so it hangs the entire apply
    unzip -o -q 1Password.zip -d onepassword
    open -nW "onepassword/1Password Installer.app"
  {{- else if (eq .chezmoi.os "linux") }}
    # Stable channel deliberately: this is a password manager, --edge tracks
    # upstream tip and is the least-reviewed build on offer.
    sudo snap install 1password
  {{- end }}
)
optional_runner install_one_password_desktop

# The 'op' CLI is separate from the desktop app. Later steps (PICO-8) read
# credentials out of 1Password with it, so it needs to exist before they run —
# hence its position here, above them. Anything that needs it also installs it
# on demand, so declining this step is safe.
install_one_password_cli() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install 1password-cli
  {{- else if (eq .chezmoi.os "linux") }}
    # The apt repo dance is documented upstream and changes often enough that
    # it's not worth freezing a copy of it here.
    skip "Install manually: https://developer.1password.com/docs/cli/get-started/"
  {{- end }}
)
optional_runner install_one_password_cli
{{- end }}

{{- if .islocalenv }}
# pdftk
install_pdftk() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    # Was pdftk_server 2.02 "mac_osx-10.11", built in 2013: an unsigned,
    # un-notarised, Intel-only .pkg that a modern macOS refuses to run. Its
    # installer also drops a launchd job and its own libgcj runtime into
    # /usr/local. pdftk-java is the maintained port, is the same `pdftk` CLI,
    # and comes as a normal formula with a JRE dependency Homebrew resolves.
    brew install pdftk-java
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install pdftk
  {{- end }}
)
optional_runner install_pdftk
{{- end }}

{{- if .islocalenv }}
{{- if (eq .chezmoi.os "linux") }}
# xournal++ (for annotaing pdfs + handwriting notes)
#
# Was: the pinned 1.1.1 "Ubuntu-focal" .deb (2021) plus a hand-installed
# libzip5. Three separate reasons that no longer works:
#   - libzip5 was dropped after 20.04; 22.04 and later carry libzip4/libzip5t64
#     under different names, so the dep line failed outright;
#   - a focal-built .deb links against focal's libraries, which is not what a
#     22.04+ machine has;
#   - upstream published no arm64 .deb for it, so half the machines this repo
#     targets could never use this branch at all.
#
# Ubuntu has packaged xournalpp itself since 20.04, for both architectures.
# That build is a point release or so behind upstream, which is a fair trade for
# a package that is signed by the archive key, gets security updates without
# this script being re-run, and needs no per-codename URL to keep current.
install_xournal() (
  set -e
  apt_get install xournalpp
)
runner install_xournal
{{- end }}
{{- end }}

{{- if .islocalenv }}
# Signal messenger
install_signal() (
  set -e
  {{- if .codespaces }}
    # Not on Codespaces
  {{- else if (eq .chezmoi.os "darwin") }}
    # Was a pinned 5.47.0 .dmg from 2022. Signal Desktop hard-expires builds a
    # few months after release: that one installs fine and then refuses to
    # launch, showing only "this version has expired". Pinning a Signal version
    # is therefore never right — the cask tracks current releases, which is the
    # only supported state for this app.
    #
    # On a machine that ran the old .dmg branch there is already a
    # /Applications/Signal.app that Homebrew did not put there, and the cask
    # will refuse rather than clobber it. That is the correct behaviour; delete
    # the old app by hand once and this step succeeds from then on. Deliberately
    # not automated: nothing here should be `rm -rf`ing /Applications.
    brew install --cask signal
  {{- else if (eq .chezmoi.os "linux") }}
    {{- if ne $arch "amd64" }}
    # Signal Desktop for Linux is published for amd64 only. Adding the repo
    # anyway would leave every subsequent `apt update` failing on a missing
    # {{ $arch }} index, so bail out cleanly instead.
    skip "Skipping Signal: upstream publishes no Linux {{ $arch }} build."
    {{- else }}
    use_temp_dir
    # Both of these used to be `tee -a`. Appending a second copy of the dearmored
    # key to an existing binary keyring corrupts it, and appending the same `deb`
    # line again makes every later `apt update` warn about a duplicate source.
    # Truncating `tee` (the idiom used by install_brave / install_gh above) makes
    # a re-run a no-op instead.
    wget -qO- https://updates.signal.org/desktop/apt/keys.asc | gpg --dearmor > signal-desktop-keyring.gpg
    sudo tee /usr/share/keyrings/signal-desktop-keyring.gpg < signal-desktop-keyring.gpg > /dev/null
    # apt reads the keyring as the unprivileged `_apt` user
    sudo chmod go+r /usr/share/keyrings/signal-desktop-keyring.gpg

    echo "deb [arch={{ $arch }} signed-by=/usr/share/keyrings/signal-desktop-keyring.gpg] https://updates.signal.org/desktop/apt `lsb_release -cs` main" | sudo tee /etc/apt/sources.list.d/signal-`lsb_release -cs`.list

    apt_get update && apt_get install signal-desktop
    {{- end }}
  {{- end }}
)
optional_runner install_signal
{{- end }}

{{- if .islocalenv }}
# PICO-8
install_pico8() (
  set -e
  {{- if .codespaces }}
    # Not on Codespaces
  {{- else }}

  {{- $pico8platform := "" }}
  {{- if (eq .chezmoi.os "darwin") }}
    {{- $pico8platform = "osx" }}
  {{- else if (eq .chezmoi.os "linux") }}
    {{- $pico8platform = "linux64" }}
  {{- end }}
  {{- $pico8zip := "/tmp/pico-8.zip" }}

  # Get credentials out of 1password.
  #
  # Deliberately fetched here at run time rather than with chezmoi's
  # onepassword* template functions. Those run while chezmoi *renders* this
  # script, which would mean a brand new machine couldn't apply at all until
  # the 1Password CLI was installed and signed in — and the CLI is installed
  # by this very script, so there was no way to bootstrap out of it.
  ITCH_ITEM="kz6tex4nh5fx7a2kvohdx6tt4e"

  # The CLI is installed by install_one_password_cli earlier in this run, but
  # that step is optional and may have been declined — so install it on demand
  # rather than making this a manual step in the middle of an automated setup.
  if ! command -v op > /dev/null 2>&1; then
    echo "1Password CLI not found, installing it first..."
    install_one_password_cli
  fi

  if ! command -v op > /dev/null 2>&1; then
    skip "Skipping PICO-8: the 1Password CLI ('op') still isn't on PATH, so the
itch.io credentials can't be read."
  fi

  # A single fetch doubles as the signed-in check: if the session is locked or
  # missing, 'op' fails here rather than part way through the download.
  #
  # Signing in is the one part that can't be automated — it needs the account
  # password or biometrics — so prompt for it rather than bailing out.
  if ! ITCH_USERNAME="$(op item get "$ITCH_ITEM" --fields label=username --reveal 2> /dev/null)"; then
    echo "1Password is locked or not signed in. Signing in now..."
    eval "$(op signin)" || true
  fi

  if ! ITCH_USERNAME="$(op item get "$ITCH_ITEM" --fields label=username --reveal 2> /dev/null)"; then
    skip "Skipping PICO-8: couldn't read the itch.io credentials from 1Password.
Run 'op signin' by hand, then re-run 'chezmoi apply'."
  fi
  ITCH_PASSWORD="$(op item get "$ITCH_ITEM" --fields label=password --reveal)"

  # Exported rather than inlined into the npx command so the password stays out
  # of the process list, where 'ps' would show it to any other user.
  export DEST_FILE={{ $pico8zip }}
  export PLATFORM={{ $pico8platform }}
  export USERNAME="$ITCH_USERNAME"
  export PASSWORD="$ITCH_PASSWORD"

  # Download the binary
  #
  # The helper is copied from the chezmoi *source* directory, not from $HOME:
  # .chezmoiignore ignores 'scripts/', so ~/scripts/install-pico8.js has never
  # existed and the old relative 'scripts/install-pico8.js' could never resolve.
  npx --package=playwright@~{{ .versions.playwright }} --yes -c 'dir=$(dirname `which playwright`)/../..; cp "{{ .chezmoi.sourceDir }}/scripts/install-pico8.js" "$dir"; cd "$dir"; node install-pico8.js'

  # Install it
  {{- if (eq .chezmoi.os "darwin") }}
    # -o: /tmp/pico-8 survives from the previous run, and an unzip overwrite
    # prompt hangs the whole apply (chezmoi passes stdin through). Unpack into a
    # fresh directory so there is nothing half-extracted to trip over either.
    PICO8_DIR="$(mktemp -d)"
    unzip -o -q {{ $pico8zip }} -d "$PICO8_DIR"
    # mv onto an existing PICO-8.app fails with "Directory not empty"
    sudo rm -rf /Applications/PICO-8.app
    mv "$PICO8_DIR/pico-8/PICO-8.app" /Applications/
    # rm -f + truncating tee, as in install_neovim: `tee -a` wrote a second
    # shebang and a second exec line, so `pico8` launched PICO-8 twice in a row.
    sudo rm -f /usr/local/bin/pico8
    sudo tee /usr/local/bin/pico8 > /dev/null <<EOF
#!/usr/bin/env bash
/Applications/PICO-8.app/Contents/MacOS/pico8 "\$@"
EOF
    sudo chmod a+x /usr/local/bin/pico8
  {{- else if (eq .chezmoi.os "linux") }}
    sudo unzip -o -q {{ $pico8zip }} -d /usr/lib
    sudo chmod a+x /usr/lib/pico-8/pico8
    sudo rm -f /usr/local/bin/pico8
    sudo ln -s /usr/lib/pico-8/pico8 /usr/local/bin/pico8
  {{- end }}

  # Setup the cart & save data directories
  mkdir -p {{ .chezmoi.homeDir }}/dev/pico-8/carts
  mkdir -p {{ .chezmoi.homeDir }}/dev/pico-8/cdata
  {{- end }}
)
optional_runner install_pico8
{{- end }}

