{{- if .islocalenv }}
# Karabiner-Elements keyboard shortcut customizer for OSX
{{- if (eq .chezmoi.os "darwin") }}
install_karabiner_elements() (
  set -e
  # Was a pinned 14.4.0 .dmg from 2022. Karabiner is a DriverKit system
  # extension, not just an app: 14.x targets macOS 10.15-12 and its extension
  # will not load at all on a current macOS, so the install "succeeded" and then
  # nothing was remapped. The cask also runs upstream's uninstall script when
  # replacing an old version, which matters for something that leaves a driver
  # and three launchd agents behind.
  #
  # The managed dot_config/private_karabiner/private_karabiner.json is already
  # in the post-15 format (it uses `keyboard_type_v2`), so it carries over.
  brew install --cask karabiner-elements
)
runner install_karabiner_elements
{{- end }}
{{- end }}

{{- if .islocalenv }}
# LICEcap screenshot utility
{{- if (eq .chezmoi.os "darwin") }}
install_licecap() (
  set -e
  install_dmg https://www.cockos.com/licecap/licecap{{ .versions.licecap }}.dmg {{ .digests.licecap }}
  # Set the default directory
  defaults write com.cockos.LICEcap.plist NSNavLastRootDirectory -string "~/Movies"
)
runner install_licecap
{{- end }}
{{- end }}

{{- if .islocalenv }}
# Discord
install_discord() (
  set -e
  {{- if .codespaces }}
    # Not on Codespaces
  {{- else if (eq .chezmoi.os "darwin") }}
    # Use the "latest" download endpoint so this doesn't pin a stale version
    install_dmg "https://discord.com/api/download?platform=osx"
  {{- else if (eq .chezmoi.os "linux") }}
    # Use the "latest" download endpoint so this doesn't pin a stale version
    use_temp_dir
    wget --no-verbose -O discord.deb "https://discord.com/api/download?platform=linux&format=deb"
    apt_get install ./discord.deb
  {{- end }}
)
optional_runner install_discord
{{- end }}

{{- if .islocalenv }}
# Moonlander keyboard setup
install_moonlander() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    # So the flashing tool can write to the keyboard
    brew install libusb

    # Install Wally, the EZ / ZSA flashing tool
    install_dmg https://configure.zsa.io/wally/osx
  {{- else if (eq .chezmoi.os "linux") }}
    # So the flashing tool can write to the keyboard
    apt_get install libusb-1.0-0-dev
    
    # Setup udev rules so the flashing tool can receive the correct events.
    # Truncating `tee`, not `tee -a`: appending re-added the same rules on every
    # run, and udev then logs a duplicate-rule warning for each copy. The
    # separate `touch` is redundant, `tee` creates the file.
    sudo tee /etc/udev/rules.d/50-wally.rules > /dev/null <<EOF
# STM32 rules for the Moonlander and Planck EZ
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", \
    MODE:="0666", \
    SYMLINK+="stm32_dfu"
EOF

    # Setup udev rules for the training software to receive the correct events
    sudo tee /etc/udev/rules.d/50-oryx.rules > /dev/null <<EOF
# Rule for all ZSA keyboards
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", GROUP="plugdev"
# Rule for the Moonlander
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", ATTR{idProduct}=="1969", GROUP="plugdev"
# Rule for the Ergodox EZ
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="1307", GROUP="plugdev"
# Rule for the Planck EZ
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="6060", GROUP="plugdev"
EOF

    # Install Wally, the EZ / ZSA flashing tool
    use_temp_dir
    wget --no-verbose https://github.com/zsa/wally/releases/download/{{ .versions.wally }}-linux/wally
    {{- if eq $arch "amd64" }}
    # Raw binary, moved into /usr/local/bin as root, and its whole job is to
    # write firmware to a device over USB. Check it.
    verify_sha256 ./wally {{ .digests.wally_amd64 }}
    {{- else }}
    # Upstream ships a single unlabelled x86_64 `wally` asset for this release,
    # so there is no {{ $arch }} build to pin a digest for. It will not run here.
    echo "⚠️  Wally is x86_64-only; the binary installed below will not run on {{ $arch }}."
    {{- end }}
    sudo mv wally /usr/local/bin/wally
    sudo chmod a+x /usr/local/bin/wally
  {{- end }}
)
optional_runner install_moonlander
{{- end }}

{{- if .islocalenv }}
# mkcert for creating SSL certs in localhost
install_mkcert() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install mkcert
    brew install nss
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install libnss3-tools
    use_temp_dir
    wget --no-verbose https://github.com/FiloSottile/mkcert/releases/download/v{{ .versions.mkcert }}/mkcert-v{{ .versions.mkcert }}-linux-{{ $arch }}
    # This is a raw binary that gets moved into /usr/local/bin as root and then
    # asked to write a trust anchor into the system CA store. Check it first.
    verify_sha256 ./mkcert-v{{ .versions.mkcert }}-linux-{{ $arch }} {{ index .digests.mkcert $arch }}
    sudo mv mkcert-v{{ .versions.mkcert }}-linux-{{ $arch }} /usr/local/bin/
    sudo chmod a+x /usr/local/bin/mkcert-v{{ .versions.mkcert }}-linux-{{ $arch }}
    sudo rm -f /usr/local/bin/mkcert
    sudo ln -s /usr/local/bin/mkcert-v{{ .versions.mkcert }}-linux-{{ $arch }} /usr/local/bin/mkcert
  {{- end }}
)
optional_runner install_mkcert
{{- end }}

{{ template "setup-summary.sh.tmpl" . }}
