#!/usr/bin/env bash
{{- /* qmd: on-device search over the Logseq notes mirror, and Tuple call and
       Google Meet summaries plus their full transcripts. Installs the CLI,
       registers the collections, and loads the launchd agent that keeps the
       index fresh.

       Ordered after 70-dev-tools (needs node) and before 80-apps.

       qmd is installed with `npm --prefix ~/.local` rather than a plain
       `npm install -g`, because fnm puts global packages inside the node
       version's own directory: installed the usual way, qmd disappears the
       moment that node version is uninstalled. ~/.local is version-independent
       and is where the other standalone CLIs already live.

       The collections live in qmd's own ~/.config/qmd/index.yml, which qmd
       rewrites whenever a collection changes, so it is registered idempotently
       here rather than managed as a static file that would fight the CLI. */}}

{{ template "setup-helpers.sh.tmpl" . }}

{{- if .islocalenv }}
{{- if (eq .chezmoi.os "darwin") }}

QMD="{{ .chezmoi.homeDir }}/.local/bin/qmd"
TUPLE_SUMMARIES="{{ .chezmoi.homeDir }}/.local/share/tuple-summaries"
TUPLE_EXPORTER="{{ .chezmoi.homeDir }}/.tuple/triggers/call-summary-qmd/export-summaries"
TUPLE_TRANSCRIPTS="{{ .chezmoi.homeDir }}/.local/share/tuple-transcripts"
TUPLE_TRANSCRIPTS_EXPORTER="{{ .chezmoi.homeDir }}/.local/bin/tuple-transcripts-export"
MEET_SUMMARIES="{{ .chezmoi.homeDir }}/.local/share/meet-summaries"
MEET_TRANSCRIPTS="{{ .chezmoi.homeDir }}/.local/share/meet-transcripts"
MEET_EXPORTER="{{ .chezmoi.homeDir }}/.local/bin/meet-notes-export"

{{- /* Logseq graph roots.

       Two layouts exist and both are supported:

         DB graph (Logseq v2)   <root>/graphs/<name>/mirror/markdown/{journals,pages}
         File graph (v1, or v2 in file mode)   <any dir>/{journals,pages}

       DB graphs are discovered by globbing the Logseq root, so the graph name is
       never hardcoded and a machine with different graphs needs no edit here.

       File graphs live at arbitrary paths — iCloud, Dropbox, a git checkout — so
       they cannot be globbed. List them per-machine in the LOCAL chezmoi config
       (~/.config/chezmoi/chezmoi.toml), which is not committed:

         [data]
           logseq_graph_roots = ["~/Documents/notes", "~/work/wiki"]

       Anything listed there is added to whatever was discovered. */}}
{{- $roots := (glob (joinPath .chezmoi.homeDir "Logseq/graphs/*/mirror/markdown")) }}
{{- if hasKey . "logseq_graph_roots" }}
{{-   range .logseq_graph_roots }}
{{-     $roots = append $roots (. | replace "~" $.chezmoi.homeDir) }}
{{-   end }}
{{- end }}

LOGSEQ_ROOTS=(
{{- range $roots }}
  {{ . | quote }}
{{- end }}
)

# Collection name for a graph root: the graph's own name, not the layout around
# it. `<root>/graphs/Demo/mirror/markdown` and `~/Documents/Demo` both yield
# "logseq-demo".
logseq_collection_name() {
  local path="$1" name
  case "$path" in
    */mirror/markdown) name=$(basename "$(dirname "$(dirname "$path")")") ;;
    *)                 name=$(basename "$path") ;;
  esac
  # lowercase, and anything not [a-z0-9] becomes a hyphen
  name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')
  printf 'logseq-%s' "$name"
}

install_qmd() (
  set -e
  if [ ! -x "$QMD" ]; then
    npm install -g --prefix "{{ .chezmoi.homeDir }}/.local" @tobilu/qmd --silent
  fi
)
runner install_qmd

# Collections. `collection add` is not idempotent, so only add what is missing.
register_qmd_collections() (
  set -e
  [ -x "$QMD" ] || exit 0
  existing=$("$QMD" collection list 2>/dev/null || true)
  registered=""

  # One collection per Logseq graph, so results keep short paths
  # (qmd://logseq-demo/journals/...) and a search can be scoped to one graph.
  for root in ${LOGSEQ_ROOTS[@]+"${LOGSEQ_ROOTS[@]}"}; do
    [ -d "$root" ] || continue
    # A graph root is only useful once Logseq has written journals or pages.
    [ -d "$root/journals" ] || [ -d "$root/pages" ] || continue
    cname=$(logseq_collection_name "$root")
    registered="$registered $cname"
    printf '%s' "$existing" | grep -q "^$cname " && continue
    "$QMD" collection add "$root" --name "$cname"
  done

  # Drop collections for graphs that have gone away, so a renamed or deleted
  # graph does not leave stale documents in the index forever.
  printf '%s' "$existing" | grep -oE '^logseq-[a-z0-9-]+' | while read -r old; do
    case " $registered " in
      *" $old "*) ;;
      *) echo "removing stale collection $old"; "$QMD" collection remove "$old" || true ;;
    esac
  done

  # Tuple call summaries. The exporter ships inside the call-summary-qmd trigger
  # (published at tupleapp/community-triggers) rather than living in ~/.local/bin,
  # so the trigger directory is the single source of truth for both halves.
  mkdir -p "$TUPLE_SUMMARIES"
  if ! printf '%s' "$existing" | grep -q '^tuple '; then
    "$QMD" collection add "$TUPLE_SUMMARIES" --name tuple
  fi
  # `|| true` so a missing or broken Tuple can never abort `qmd update`, which
  # also syncs the Logseq collections. Byte-for-byte the command the trigger
  # itself registers (its `: tuple-call-summary-qmd;` ownership marker included),
  # so the two never rewrite each other's update command.
  "$QMD" collection update-cmd tuple \
    ": tuple-call-summary-qmd; TUPLE_QMD_OUT=$(printf '%q' "$TUPLE_SUMMARIES") $(printf '%q' "$TUPLE_EXPORTER") || true"

  # Summaries and full transcripts are separate collections because they rank
  # differently: summaries win "what did we decide", transcripts "who said
  # exactly what". A pair shares a filename and each file links to the other.
  # Each transcripts collection is registered after its summaries, so `qmd
  # update` (which goes in registration order) exports and indexes the summary
  # first. Contexts are returned with every hit, so an agent always knows which
  # half it is reading, and that transcripts must stay on this machine.
  local_only="LOCAL-ONLY: verbatim, including personal conversation. Never copy any of it into Slack, Linear, GitHub or any other shared space."
  mkdir -p "$TUPLE_TRANSCRIPTS"
  if ! printf '%s' "$existing" | grep -q '^tuple-transcripts '; then
    "$QMD" collection add "$TUPLE_TRANSCRIPTS" --name tuple-transcripts
  fi
  "$QMD" collection update-cmd tuple-transcripts \
    "TUPLE_TRANSCRIPTS_OUT=$(printf '%q' "$TUPLE_TRANSCRIPTS") $(printf '%q' "$TUPLE_TRANSCRIPTS_EXPORTER") || true"
  "$QMD" context add qmd://tuple/ \
    "Tuple call summaries, one file per call. The full transcript is the same-named file in qmd://tuple-transcripts/."
  "$QMD" context add qmd://tuple-transcripts/ \
    "Full Tuple call transcripts, one file per call, one '[HH:MM:SS] Speaker: text' line per utterance. $local_only The call's summary is the same-named file in qmd://tuple/."

  # Gemini meeting notes from Google Drive. The exporter needs a one-off
  # `meet-notes-auth` to mint a refresh token — it cannot be provisioned from
  # here because it needs a browser — so only register the collection once that
  # has happened. Until then the directory would just stay empty.
  if [ -x "$MEET_EXPORTER" ] && [ -f "{{ .chezmoi.homeDir }}/.config/meet-notes/token.json" ]; then
    mkdir -p "$MEET_SUMMARIES"
    if ! printf '%s' "$existing" | grep -q '^meet '; then
      "$QMD" collection add "$MEET_SUMMARIES" --name meet
    fi
    "$QMD" collection update-cmd meet "'$MEET_EXPORTER' || true"
    # Written by the same exporter as meet, so it needs no update command.
    mkdir -p "$MEET_TRANSCRIPTS"
    if ! printf '%s' "$existing" | grep -q '^meet-transcripts '; then
      "$QMD" collection add "$MEET_TRANSCRIPTS" --name meet-transcripts
    fi
    "$QMD" context add qmd://meet/ \
      "Google Meet notes by Gemini, one file per meeting. A '(00:05:47, transcript L123)' citation is line 123 of the same-named file in qmd://meet-transcripts/."
    "$QMD" context add qmd://meet-transcripts/ \
      "Full Google Meet transcripts, one file per meeting, under '### HH:MM:SS' headings. $local_only The meeting's notes are the same-named file in qmd://meet/."
  fi
)
runner register_qmd_collections

# Keep the index fresh: 5-minute poll plus WatchPaths on the Logseq mirror.
load_qmd_sync_agent() (
  set -e
  plist="{{ .chezmoi.homeDir }}/Library/LaunchAgents/com.jess.qmd-sync.plist"
  [ -f "$plist" ] || exit 0
  launchctl unload "$plist" 2>/dev/null || true
  launchctl load -w "$plist"
)
runner load_qmd_sync_agent

# Tuple triggers fire the post-call summariser. Enabling them registers a
# Background Item via SMAppService, which only the app itself can do — the state
# lives in /var/db/com.apple.backgroundtaskmanagement (root-only, SIP-protected),
# so there is no `defaults write` that turns this on. Detect and report instead.
check_tuple_triggers() (
  set -e
  [ -d "{{ .chezmoi.homeDir }}/.tuple/triggers" ] || exit 0
  if launchctl print "gui/$(id -u)/app.tuple.app.triggers" >/dev/null 2>&1; then
    exit 0
  fi
  skip "Tuple Triggers are OFF — the post-call summariser will not fire.
     Turn them on in Tuple → Settings → Triggers (registers a Background Item).
     Verify with:
       launchctl print gui/\$(id -u)/app.tuple.app.triggers >/dev/null 2>&1 \\
         && echo ON || echo OFF"
)
runner check_tuple_triggers

{{- end }}
{{- end }}

{{ template "setup-summary.sh.tmpl" . }}
