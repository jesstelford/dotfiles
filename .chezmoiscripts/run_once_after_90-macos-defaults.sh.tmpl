#!/usr/bin/env bash
{{- /* macOS system configuration: the ~35 `defaults write` calls, the
       software-update schedule dance and the Rectangle/Dock/Finder settings.

       run_once_, not run_onchange_: this is one-time machine configuration. As
       a run_onchange_ script, editing any one `defaults write` re-ran all of
       them and re-prompted for sudo. It also interpolates the lock screen
       email, so re-running `chezmoi init` with a different answer used to
       replay the lot. */}}

{{ template "setup-helpers.sh.tmpl" . }}

{{- if .islocalenv }}
{{- if (eq .chezmoi.os "darwin") }}

configure_macos() (
  set -e
  # Setup MacOS OS-level settings
  # See: https://gist.github.com/vraravam/5e28ca1720c9dddacdc0e6db61e093fe

  # Close any open System Preferences panes, to prevent them from overriding
  # settings we're about to change
  osascript -e 'tell application "System Preferences" to quit'

  # The sudo keep-alive that used to live here is now in setup-helpers.sh.tmpl,
  # so it covers every script rather than just this one — and it has an EXIT
  # trap, which this copy lacked. `$$` inside the backgrounded subshell is the
  # whole script's PID, not this function's, so the old loop kept refreshing
  # sudo for the rest of the chezmoi run after configure_macos returned.

  # While applying any changes to SoftwareUpdate defaults, set software update to OFF to avoid any conflict with the defaults system cache. (Also close the System Preferences app)
  #
  # The trap is registered *before* the OFF so the restore is unconditional:
  # `set -e` means any failing command below aborts this subshell, and without
  # the trap that left the machine with automatic software updates permanently
  # disabled. `|| true` keeps a failing restore from masking the real exit code.
  trap 'sudo softwareupdate --schedule ON || true' EXIT
  sudo softwareupdate --schedule OFF

  # Disable guest login
  sudo defaults write /Library/Preferences/com.apple.loginwindow GuestEnabled -bool false

  # Message added to lock screen
  sudo defaults write /Library/Preferences/com.apple.loginwindow LoginwindowText "Contact: {{ .lockscreenemail }}"

  # Show remaining battery percentage" Y; then
  defaults write com.apple.menuextra.battery ShowPercent -string "YES"

  # Disable automatic capitalization as it's annoying when typing code
  defaults write -g NSAutomaticCapitalizationEnabled -bool false

  # Disable automatic period substitution as it's annoying when typing code
  defaults write -g NSAutomaticPeriodSubstitutionEnabled -bool false

  # Fix the track pad scrolling direction
  defaults write -g com.apple.swipescrolldirection -bool false

  # Show all filename extensions
  defaults write -g AppleShowAllExtensions -bool true

  # Show the POSIX path at the top of Finder
  defaults write com.apple.finder _FXShowPosixPathInTitle -bool true

  # Finder: show hidden files by default
  defaults write com.apple.finder AppleShowAllFiles -bool true

  # Disable the warning when changing a file extension
  defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

  # Avoid creating .DS_Store files on network or USB volumes
  defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
  defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

  # Prevent Photos from opening automatically when devices are plugged in
  defaults -currentHost write com.apple.ImageCapture disableHotPlug -bool true

  # Add a context menu item for showing the Web Inspector in web views
  defaults write -g WebKitDeveloperExtras -bool true

  # Don't default to saving documents to iCloud:
  defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

  # Set your screen to lock as soon as the screensaver starts:
  defaults write com.apple.screensaver askForPassword -int 1
  defaults write com.apple.screensaver askForPasswordDelay -int 0

  # Save screenshots to the desktop
  mkdir -p "${HOME}/Desktop/screenshots"
  defaults write com.apple.screencapture location -string "${HOME}/Desktop/screenshots"

  # Save screenshots in PNG format (other options: BMP, GIF, JPG, PDF, TIFF)
  defaults write com.apple.screencapture type -string "png"

  # Increase key repeat speed
  defaults write -g InitialKeyRepeat -int 12
  defaults write -g KeyRepeat -int 1

  # Sane scroll direction
  defaults write -g com.apple.swipescrolldirection -bool NO
  
  # Fix display issues. See: https://tonsky.me/blog/monitors/
  # Disable font smoothing to avoid bad antialiasing
  defaults -currentHost write -g AppleFontSmoothing -int 0
  
  # Disable 2 finger swiping for back/forward
  defaults write NSGlobalDomain AppleEnableSwipeNavigateWithScrolls -bool false
  defaults write com.google.Chrome AppleEnableMouseSwipeNavigateWithScrolls -bool false
  defaults write com.google.Chrome AppleEnableSwipeNavigateWithScrolls -bool false

  # Rectangle window manager (installed by install_rectangle above).
  # These used to live as a checked-in ~/Library/Preferences plist, but macOS
  # caches prefs in cfprefsd and rewrites that file whenever Rectangle quits, so
  # a chezmoi-managed copy could never stay clean. Driving it through `defaults`
  # is the only stable way. Rectangle has to be stopped first, otherwise it
  # flushes its own in-memory prefs over the top of ours when it next exits.
  killall Rectangle 2>/dev/null || true
  # Spectacle-compatible shortcuts rather than Rectangle's own defaults
  defaults write com.knollsoft.Rectangle alternateDefaultShortcuts -bool true
  defaults write com.knollsoft.Rectangle launchOnLogin -bool true
  # 0 = double-clicking a title bar does nothing (keeps macOS zoom out of the way)
  defaults write com.knollsoft.Rectangle doubleClickTitleBar -int 0
  # 3 = repeating the same shortcut cycles through sizes (e.g. 1/2 -> 2/3 -> 1/3)
  defaults write com.knollsoft.Rectangle subsequentExecutionMode -int 3
  # modifierFlags 786432 = control+option. keyCode 11 = "b", keyCode 45 = "n".
  defaults write com.knollsoft.Rectangle toggleTodo -dict keyCode -int 11 modifierFlags -int 786432
  defaults write com.knollsoft.Rectangle reflowTodo -dict keyCode -int 45 modifierFlags -int 786432
  open -g -a Rectangle 2>/dev/null || true

  # Don't autoconnect to Bluetooth headphones (MacOS aggressively steals Bluetooth source from my phone),
  # but still allow manual connection to audio devices, and auto connection to keyboard / mouse / etc.
  # See: https://apple.stackexchange.com/a/226169
  #
  # /Library/Preferences is root-owned, so this needs sudo; without it `defaults`
  # fails and (under `set -e`) takes the rest of this function with it.
  sudo defaults write /Library/Preferences/com.apple.Bluetooth.plist DontPageAudioDevices 1

  # Software updates are turned back ON by the EXIT trap registered at the top.
)
runner configure_macos

# AltTab: start at login, and set shortcut 1 plus the switcher's appearance.
#
# Start at login has no preference key -- AltTab's own binary references
# LSSharedFileList and it writes a LaunchAgent when you tick the box in its UI.
# So write that agent directly. Content is byte-for-byte what AltTab itself
# writes, read off a machine where the box was ticked.
#
# The shortcut is the awkward part. AltTab stores it as a dict of
#   { string = "<glyph>"; secureData = <NSKeyedArchiver blob> }
# where the blob is an archived ShortcutRecorder SRShortcut carrying
# modifierFlags and keyCode. A plain string will not do -- the archive is what
# is actually read. The two blobs below were built by decoding the real archive
# AltTab wrote, substituting the values, and confirming they re-decode to the
# right SRShortcut:
#
#   holdShortcut        modifierFlags 262144 (control), keyCode 65535
#                       65535 is SRKeyCodeNone, i.e. a modifier-only shortcut,
#                       which is what "hold" means here.
#   nextWindowShortcut  modifierFlags 0, keyCode 48 (tab)
#
# Together: hold Control, press Tab.
#
# appearanceStyle / appearanceSize are plain ints. The orderings are taken from
# the enums in AltTab's binary, not guessed:
#   appearanceStyle  0 thumbnails, 1 appIcons, 2 titles
#   appearanceSize   0 small,      1 medium,   2 large
configure_alttab() (
  set -e

  # AltTab has to be stopped first for the same reason Rectangle does: macOS
  # caches preferences in cfprefsd and the app flushes its own copy over ours
  # when it next exits.
  killall AltTab 2>/dev/null || true

  hold_
  next_

  defaults write com.lwouis.alt-tab-macos holdShortcut \
    "{ string = \"⌃\"; secureData = <$hold_shortcut>; }"
  defaults write com.lwouis.alt-tab-macos nextWindowShortcut \
    "{ string = \"⇥\"; secureData = <$next_shortcut>; }"

  defaults write com.lwouis.alt-tab-macos appearanceStyle -int 0
  defaults write com.lwouis.alt-tab-macos appearanceSize -int 1

  # Start at login.
  agent="$HOME/Library/LaunchAgents/com.lwouis.alt-tab-macos.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$agent" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AssociatedBundleIdentifiers</key>
	<string>com.lwouis.alt-tab-macos</string>
	<key>Label</key>
	<string>com.lwouis.alt-tab-macos</string>
	<key>LegacyTimers</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>Program</key>
	<string>/Applications/AltTab.app/Contents/MacOS/AltTab</string>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
PLIST
  plutil -lint "$agent" > /dev/null

  # bootout first so a re-run replaces the definition rather than erroring with
  # "service already loaded". Both are best-effort: the agent is picked up at
  # the next login regardless.
  launchctl bootout "gui/$(id -u)/com.lwouis.alt-tab-macos" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$agent" 2>/dev/null || true

  open -g -a AltTab 2>/dev/null || true
)
runner configure_alttab

# Launch Rocket and Karabiner-Elements at login.
#
# Rocket has a `launch-at-login` preference, set in install_emoji_picker, and it
# turns out that is NOT enough: Rocket writes no LaunchAgent and registers no
# login item, so on a fresh machine it had to be started by hand despite the key
# reading true. Rectangle's own `launchOnLogin` key does work, which is why that
# one is left alone.
#
# Karabiner-Elements only needs its app launched. It registers its own
# org.pqrs.service.agent.* services itself, once it has been opened and granted
# Input Monitoring plus the driver extension in System Settings -- approvals no
# script can give. Getting the app in front of the user at login is the part
# that can be automated, and is all that was asked for.
#
# Deliberately NOT gated on the install steps: install_emoji_picker and
# install_karabiner both skip early when the app is already present, so a login
# agent written inside them would never appear on a machine that already had the
# app. This runs unconditionally instead.
#
# AltTab is not here because configure_alttab above writes AltTab's own agent,
# under AltTab's own label, byte-for-byte as AltTab writes it -- so AltTab's
# "start at login" checkbox reflects reality. Rocket and Karabiner have no such
# agent to imitate.
configure_login_items() (
  set -e
  add_login_agent st.jes.login.rocket /Applications/Rocket.app
  add_login_agent st.jes.login.karabiner-elements /Applications/Karabiner-Elements.app
  echo "Login agents written for Rocket and Karabiner-Elements."
)
runner configure_login_items
{{- end }}
{{- end }}

{{ template "setup-summary.sh.tmpl" . }}
