#!/usr/bin/env bash
{{- /* Command-line tools: tmux, cmux, Claude Code, ant, bat, eza, fd, delta,
       uv, and the handful of language servers/formatters that are useful
       outside Neovim (the rest are Mason's job). */}}
{{- /*
  Architecture spellings. .chezmoi.arch is Go's GOARCH — "amd64" or "arm64" on
  every machine this repo targets — and upstreams spell it four different ways:

    $arch      amd64  | arm64     dpkg / .deb assets / Go's own tarballs
    $archnvim  x86_64 | arm64     Neovim release assets
    $archlua   x64    | arm64     lua-language-server release assets
    $archgnu   x86_64 | aarch64   GNU triplet spelling; DBeaver release assets

  Derived per script rather than once globally: a template variable set inside
  an included .chezmoitemplates file is scoped to that template, so it cannot be
  shared the way the shell helpers are. Each script derives only the spellings
  it actually uses.
*/}}
{{- $arch := .chezmoi.arch }}
{{- $archlua := $arch }}
{{- if eq $arch "amd64" }}
{{-   $archlua = "x64" }}
{{- end }}
{{- /*
  Download integrity.

  Every download here arrives over TLS, which authenticates the host and says
  nothing whatsoever about the bytes. So: where a download is pinned to a
  version, the SHA-256 of that exact asset is pinned beside it in
  .chezmoidata.toml and checked with verify_sha256 before anything is
  installed. See that file's header for how to refresh a digest.
*/}}

{{ template "setup-helpers.sh.tmpl" . }}

{{- /* powerlevel10k used to be cloned here; it is now a git-repo external in
       .chezmoiexternal.toml. */}}

# tmux
install_tmux() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install tmux
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install tmux
  {{- end }}
)
runner install_tmux

{{- if .islocalenv }}
{{- if (eq .chezmoi.os "darwin") }}
# cmux
# GUI app: only ever wanted on a real desktop, never in codespaces or CI.
install_cmux() (
  set -e
  brew tap manaflow-ai/cmux
  brew install --cask cmux
)
runner install_cmux
{{- end }}
{{- end }}

# Claude Code (Anthropic's agentic coding CLI)
install_claude_code() (
  set -e
  # No brew on Linux; use the native installer (auto-updates in the background)
  curl -fsSL https://claude.ai/install.sh | bash
)
runner install_claude_code

# ant (Anthropic's CLI for the Claude platform)
#
# Deliberately unpinned on both platforms, so there is no .chezmoidata.toml
# entry: this is a client for a hosted API that moves underneath it, where an
# old version is a liability rather than a stable known-good. Same call as Go in
# 70-dev-tools, and for the same reason.
install_ant() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    # A cask rather than a formula, and one that ships its own completions:
    # brew symlinks the tarball's completions/ant.zsh into
    # $HOMEBREW_PREFIX/share/zsh/site-functions as _ant, and `brew shellenv`
    # already puts that directory on fpath (see the note in .zshrc). So there is
    # nothing for this branch to generate, unlike the Linux one below.
    #
    # `brew trust` first, because Homebrew now requires trust for third-party
    # taps and, depending on its version, either quietly ignores an untrusted
    # one or hard-errors with "Refusing to load ... from untrusted tap" -- the
    # wall that used to abort install_fonts on every fresh machine (see the NOTE
    # in 40-desktop). Without this the cask installs on the machine that trusted
    # it by hand and on no other.
    #
    # Scoped to this one cask rather than `brew trust anthropics/tap`, which
    # would silently extend to anything else that lands in that tap later. It is
    # idempotent, exits 0 when already trusted, and does not need the tap tapped.
    brew trust --cask anthropics/tap/ant
    brew install anthropics/tap/ant
  {{- else if (eq .chezmoi.os "linux") }}
    use_temp_dir

    # Resolve the latest release WITHOUT api.github.com: /releases/latest is a
    # 302 to /releases/tag/vX.Y.Z, and the API is rate limited to 60 requests an
    # hour per IP for unauthenticated callers -- a budget a shared CI runner has
    # usually already spent on someone else's job.
    #
    # `sed -n .../p` rather than a suffix strip: when the redirect does not
    # happen, curl reports the URL it was given, and a strip that finds no match
    # yields that whole URL as the "version". This yields nothing instead, which
    # the check below can see.
    ant_url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/anthropics/anthropic-cli/releases/latest)"
    ant_version="$(printf '%s' "$ant_url" | sed -n 's#.*/releases/tag/v##p')"
    if [ -z "$ant_version" ]; then
      echo "❌ Could not resolve the latest ant release."
      echo "   /releases/latest resolved to: $ant_url"
      exit 1
    fi

    # Nothing to do when the installed copy is already that release. Not merely
    # tidy: without this, every apply re-downloads 23MB to arrive at the bytes
    # already on disk. `ant --version` prints "ant version X.Y.Z".
    if [ "$(ant --version 2>/dev/null | awk '{ print $NF }')" = "$ant_version" ]; then
      skip "ant $ant_version is already the latest release."
    fi

    ant_base="https://github.com/anthropics/anthropic-cli/releases/download/v${ant_version}"
    ant_tarball="ant_${ant_version}_linux_{{ $arch }}.tar.gz"

    # Unpinned, so its digest cannot be pinned either. Upstream publishes a
    # checksums file per release, so fetch that alongside the tarball and check
    # against it -- the same trade, with the same limits, as install_golang:
    # both come from github.com over the same TLS trust root, so this defends
    # against a corrupted or substituted mirror response, not against a
    # compromised GitHub.
    wget --no-verbose "${ant_base}/${ant_tarball}"
    wget --no-verbose -O ant_checksums.txt "${ant_base}/ant_${ant_version}_checksums.txt"
    ant_sha256="$(awk -v want="$ant_tarball" '$2 == want { print $1 }' ant_checksums.txt)"
    if [ -z "$ant_sha256" ]; then
      echo "❌ No published SHA-256 for ${ant_tarball}; refusing to install it unverified."
      exit 1
    fi
    verify_sha256 "./${ant_tarball}" "$ant_sha256"

    # The tarball carries the binary at its root, alongside completions/ and
    # man/. `install` rather than `cp`: it unlinks and recreates, so replacing a
    # copy of ant that is currently running cannot corrupt the running process.
    tar xzf "$ant_tarball"
    sudo install -m 755 ant /usr/local/bin/ant

    # zsh completion, taken out of the tarball rather than generated by
    # `ant @completion zsh` -- that would mean executing a binary downloaded
    # seconds ago to produce a file already sitting next to it. ~/.zsh/completion
    # is on fpath (see .zshrc); this is the same thing install_fnm does for _fnm.
    mkdir -p "$HOME/.zsh/completion"
    cp completions/ant.zsh "$HOME/.zsh/completion/_ant"
  {{- end }}
)
runner install_ant

# bat
install_bat() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install bat
  {{- else if (eq .chezmoi.os "linux") }}
    use_temp_dir
    wget --no-verbose https://github.com/sharkdp/bat/releases/download/v{{ .versions.bat }}/bat_{{ .versions.bat }}_{{ $arch }}.deb
    verify_sha256 ./bat_{{ .versions.bat }}_{{ $arch }}.deb {{ index .digests.bat $arch }}
    apt_get install ./bat_{{ .versions.bat }}_{{ $arch }}.deb
  {{- end }}
)
runner install_bat

# eza (modern ls replacement; the `ls` alias falls back to system ls if absent)
install_eza() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install eza
  {{- else if (eq .chezmoi.os "linux") }}
    # eza is in apt on Ubuntu 24.04+; on older releases this fails harmlessly
    # and the ls alias falls back to system ls
    apt_get install eza
  {{- end }}
)
runner install_eza

# fd
install_fd() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install fd
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install fd-find
    # Override the other `fd` binary that comes with Ubuntu
    sudo rm -f /usr/local/bin/fd
    sudo ln -s $(which fdfind) /usr/local/bin/fd
  {{- end }}
)
runner install_fd

# delta
install_delta() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install git-delta
  {{- else if (eq .chezmoi.os "linux") }}
    use_temp_dir
    wget --no-verbose https://github.com/dandavison/delta/releases/download/{{ .versions.delta }}/git-delta_{{ .versions.delta }}_{{ $arch }}.deb
    verify_sha256 ./git-delta_{{ .versions.delta }}_{{ $arch }}.deb {{ index .digests.delta $arch }}
    apt_get install ./git-delta_{{ .versions.delta }}_{{ $arch }}.deb
  {{- end }}
)
runner install_delta

# uv (python package manager)
install_uv() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install uv
  {{- else if (eq .chezmoi.os "linux") }}
    {{- /* UV_NO_MODIFY_PATH, for the same reason install_rust passes
           --no-modify-path: chezmoi owns the shell rc files, and
           dot_zshrc.tmpl already puts $HOME/.local/bin on PATH. Without it the
           installer writes ~/.local/bin/env and appends a line sourcing it to
           .zshrc, which chezmoi reverts on the next apply -- so the line is
           both redundant and futile, and the machine never converges.

           It only appends when the install dir is not ALREADY on PATH (see
           `in *:$_install_dir:*) NO_MODIFY_PATH=1` in install.sh), which is why
           this never appeared on the GitHub runner, where ~/.local/bin is on
           PATH, and showed up only in the devcontainer, where it is not.

           UV_NO_MODIFY_PATH rather than the older --no-modify-path flag: the
           installer deprecated that flag in favour of this variable. */}}
    curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh
  {{- end }}
)
runner install_uv

# Language servers are Mason's job, not this script's: LazyVim drives Mason from
# the extras enabled in dot_config/nvim/lazyvim.json, so anything installed here
# is either a duplicate or an orphan. Only the servers Mason cannot reasonably
# own are provisioned below.

# html / css / json / eslint servers. Kept here rather than left to Mason
# because they are also useful outside Neovim.
install_vscode_lsp() (
  set -e
  npm install -g vscode-langservers-extracted --silent
)
runner install_vscode_lsp

# The TypeScript compiler itself, for `tsc` on the command line. NOT a language
# server: LazyVim's typescript extra uses vtsls, installed by Mason.
install_typescript() (
  set -e
  npm install -g typescript --silent
)
runner install_typescript

install_lua_lsp() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install lua-language-server
  {{- else if (eq .chezmoi.os "linux") }}
    use_temp_dir
    wget --no-verbose https://github.com/LuaLS/lua-language-server/releases/download/{{ .versions.lua_language_server }}/lua-language-server-{{ .versions.lua_language_server }}-linux-{{ $archlua }}.tar.gz
    verify_sha256 ./lua-language-server-{{ .versions.lua_language_server }}-linux-{{ $archlua }}.tar.gz {{ index .digests.lua_language_server $arch }}
    sudo mkdir -p /usr/local/lib/lua-language-server
    sudo tar xzf lua-language-server-{{ .versions.lua_language_server }}-linux-{{ $archlua }}.tar.gz -C /usr/local/lib/lua-language-server
    # Only the entrypoint needs to be executable. Do NOT make the tree writable:
    # /usr/local/bin/lua-language-server symlinks in here and Neovim auto-launches
    # it for every .lua file, so a world-writable tree is a local code-exec hole.
    sudo chmod a+x /usr/local/lib/lua-language-server/bin/lua-language-server
    sudo rm -f /usr/local/bin/lua-language-server
    sudo ln -s /usr/local/lib/lua-language-server/bin/lua-language-server /usr/local/bin/lua-language-server
  {{- end }}
)
runner install_lua_lsp

install_prettierd() (
  set -e
  npm install -g @fsouza/prettierd --silent
)
runner install_prettierd

# For neovim support in lazyvim (or something, not sure tbh)
install_neovim_npm() (
  set -e
  npm install -g neovim --silent
)
runner install_neovim_npm

