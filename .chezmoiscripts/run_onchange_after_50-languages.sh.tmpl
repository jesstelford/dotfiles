#!/usr/bin/env bash
{{- /* Node and its toolchain: fnm, the pinned node version, yarn.

       Deliberately before 60-cli-tools: everything npm-installed there (the
       language servers, prettierd, the neovim npm package) needs the node fnm
       puts on PATH here. */}}

{{ template "setup-helpers.sh.tmpl" . }}

# fnm (node version manager)
#
# Deliberately NOT gated on .islocalenv: with Spin gone, fnm is the only way
# node gets installed, and install_node / .zshrc both call it unconditionally.
# Gating it here is what broke node in codespaces and CI.
install_fnm() (
  set -e
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --force-install --skip-shell --install-dir $HOME/.fnm
  # Install the shell completions manually for zsh (because this script is run
  # in bash on first install by chezmoi)
  mkdir -p $HOME/.zsh/completion
  $HOME/.fnm/fnm completions --shell zsh > $HOME/.zsh/completion/_fnm
)
runner install_fnm

if [ -f "$HOME/.fnm/fnm" ];
then
  # Ensure fnm's executable, etc, is loaded into the current environment so we
  # can run it in the following commands
  eval "$($HOME/.fnm/fnm env)"
fi

# node
install_node() (
  set -e
  $HOME/.fnm/fnm install v{{ .versions.node }}
  $HOME/.fnm/fnm default v{{ .versions.node }}
)
runner install_node

# yarn
install_yarn() (
  set -e
  npm install --global yarn
)
optional_runner install_yarn

{{ template "setup-summary.sh.tmpl" . }}
