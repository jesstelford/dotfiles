#!/usr/bin/env bash
{{- /* Homebrew bootstrap, and nothing else.

       run_once_, not run_onchange_: installing Homebrew is a once-per-machine
       bootstrap. As a run_onchange_ script any edit to it re-ran the upstream
       installer, which re-prompts for sudo.

       Deliberately does NOT include .chezmoitemplates/setup-helpers.sh.tmpl:
       that helper block probes for `brew shellenv` on macOS, and brew does not
       exist yet at the top of the script that installs brew. Nothing here is
       wrapped in `runner` for the same reason, so there is no summary block
       either. */}}
{{- if (eq .chezmoi.os "darwin") }}
# install homebrew
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Ensure it's available on the path.
# Homebrew's prefix is /opt/homebrew on Apple Silicon but /usr/local on Intel,
# so probe both rather than assuming one.
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
echo "Installed brew"
{{- end }}

