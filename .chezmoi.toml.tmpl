{{- /* Detect GitHub Codespaces and store presence in $codespaces */}}
{{- $codespaces:= env "CODESPACES" | not | not }}

{{- /* Detect CI and store presence in $ci */}}
{{- $ci:= env "CI" | not | not }}

{{- /* When available, provide a better experience when interactive */}}
{{- $islocalenv:= (and (not $codespaces) (not $ci)) }}

[data]
  islocalenv = {{ $islocalenv }}
  codespaces = {{ $codespaces }}
  ci = {{ $ci }}
{{- if $islocalenv }}
{{- /* promptStringOnce reuses the answer already in the config, so re-running
       `chezmoi init` to pick up a change to this template doesn't re-ask (and
       an accidental empty Enter can't blank out an existing value) */}}
{{- $gitemail := promptStringOnce . "gitemail" "Enter your git email" }}
  gitemail = {{ $gitemail | quote }}
{{- $lockscreenemail := promptStringOnce . "lockscreenemail" "Enter email to display on lock screen" }}
  lockscreenemail = {{ $lockscreenemail | quote }}
{{- end }}

[git]
{{- if $islocalenv }}
{{- /*
     This repo is PUBLIC. autoCommit is fine — a local commit is revocable, and
     it keeps the source dir from silently drifting. autoPush is NOT: a bad
     `chezmoi add` would publish before anyone could look at it, and a push to a
     public repo cannot be retracted (force-pushing does not remove the objects;
     GitHub keeps orphaned commits reachable by SHA through the API). Review the
     auto-commit, then push it yourself with `chezmoi git -- push`.
*/}}
  autoCommit = true
  autoPush = false
{{- end }}
{{- /* bat is installed by the setup script, i.e. *after* this config is
       written, and never in CI/Codespaces. Only wire it up as the diff pager
       when it's actually on $PATH, otherwise `chezmoi diff` dies with
       `exec: "bat": executable file not found in $PATH` */}}
{{- if lookPath "bat" }}

[diff]
  pager = "bat"
{{- end }}
