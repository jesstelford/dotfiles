# Configuration for Alacritty, the GPU enhanced terminal emulator.
#
# Migrated from the deprecated YAML format (Alacritty >= 0.13 uses TOML).
# Only the actual overrides are kept here; everything else is Alacritty default.
# If Alacritty ever rejects a key, re-run `alacritty migrate` against the old YAML.

[env]
# NOTE: the `alacritty` TERM value requires the alacritty terminfo be installed
# https://github.com/alacritty/alacritty/blob/master/INSTALL.md#terminfo
TERM = "alacritty"
# Ensure tmux always uses the right language
LC_ALL = "en_AU.UTF-8"
LANG = "en_AU.UTF-8"

[window]
startup_mode = "Maximized"

[font]
{{- if (eq .chezmoi.os "darwin") }}
size = 18.0
{{- else if (eq .chezmoi.os "linux") }}
size = 14.0
{{- end }}

[font.normal]
family = "InputMono Nerd Font"
style = "Extra Light"

[terminal.shell]
program = "/bin/zsh"
args = ["--login"]

[colors]
# "Snazzy" theme from https://github.com/alebelcor/alacritty-snazzy
draw_bold_text_with_bright_colors = true

[colors.primary]
background = "#282a36"
foreground = "#eff0eb"

[colors.cursor]
cursor = "#97979b"

[colors.selection]
text = "#282a36"
background = "#feffff"

[colors.normal]
black   = "#282a36"
red     = "#ff5c57"
green   = "#5af78e"
yellow  = "#f3f99d"
blue    = "#57c7ff"
magenta = "#ff6ac1"
cyan    = "#9aedfe"
white   = "#f1f1f0"

[colors.bright]
black   = "#686868"
red     = "#ff5c57"
green   = "#5af78e"
yellow  = "#f3f99d"
blue    = "#57c7ff"
magenta = "#ff6ac1"
cyan    = "#9aedfe"
white   = "#eff0eb"

[keyboard]
# chars use TOML unicode escapes: \u0000 is Ctrl-Space (NUL), \u001E is Ctrl-6
bindings = [
  # Open a new Alacritty window
  { key = "N", mods = "Command", command = { program = "open", args = ["-nb", "io.alacritty"] } },
  # Send Ctrl-Space+p (Previous tab/window in tmux)
  { key = "Left", mods = "Command|Option", chars = "\u0000p" },
  # Send Ctrl-Space+n (Next tab/window in tmux)
  { key = "Right", mods = "Command|Option", chars = "\u0000n" },
  # Pass through Ctrl-6 to neovim
  { key = "6", mods = "Control", chars = "\u001E" },
]
