# Signal messenger
install_signal() (
  set -e
  {{- if .codespaces }}
    # Not on Codespaces
  {{- else if (eq .chezmoi.os "darwin") }}
    # Was a pinned 5.47.0 .dmg from 2022. Signal Desktop hard-expires builds a
    # few months after release: that one installs fine and then refuses to
    # launch, showing only "this version has expired". Pinning a Signal version
    # is therefore never right — the cask tracks current releases, which is the
    # only supported state for this app.
    #
    # On a machine that ran the old .dmg branch there is already a
    # /Applications/Signal.app that Homebrew did not put there, and the cask
    # will refuse rather than clobber it. That is the correct behaviour; delete
    # the old app by hand once and this step succeeds from then on. Deliberately
    # not automated: nothing here should be `rm -rf`ing /Applications.
