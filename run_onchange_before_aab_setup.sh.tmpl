{{- if .islocalenv }}
# Moonlander keyboard setup
install_moonlander() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    # So the flashing tool can write to the keyboard
    brew install libusb

    # Install Wally, the EZ / ZSA flashing tool
    install_dmg https://configure.zsa.io/wally/osx
  {{- else if (eq .chezmoi.os "linux") }}
    # So the flashing tool can write to the keyboard
    apt_get install libusb-1.0-0-dev
    
    # Setup udev rules so the flashing tool can receive the correct events.
    # Truncating `tee`, not `tee -a`: appending re-added the same rules on every
    # run, and udev then logs a duplicate-rule warning for each copy. The
    # separate `touch` is redundant, `tee` creates the file.
    sudo tee /etc/udev/rules.d/50-wally.rules > /dev/null <<EOF
# STM32 rules for the Moonlander and Planck EZ
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", \
    MODE:="0666", \
    SYMLINK+="stm32_dfu"
EOF

    # Setup udev rules for the training software to receive the correct events
    sudo tee /etc/udev/rules.d/50-oryx.rules > /dev/null <<EOF
# Rule for all ZSA keyboards
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", GROUP="plugdev"
# Rule for the Moonlander
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", ATTR{idProduct}=="1969", GROUP="plugdev"
# Rule for the Ergodox EZ
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="1307", GROUP="plugdev"
# Rule for the Planck EZ
SUBSYSTEM=="usb", ATTR{idVendor}=="feed", ATTR{idProduct}=="6060", GROUP="plugdev"
EOF

    # Install Wally, the EZ / ZSA flashing tool
    use_temp_dir
    wget --no-verbose https://github.com/zsa/wally/releases/download/{{ .versions.wally }}-linux/wally
    {{- if eq $arch "amd64" }}
    # Raw binary, moved into /usr/local/bin as root, and its whole job is to
    # write firmware to a device over USB. Check it.
    verify_sha256 ./wally {{ .digests.wally_amd64 }}
    {{- else }}
    # Upstream ships a single unlabelled x86_64 `wally` asset for this release,
    # so there is no {{ $arch }} build to pin a digest for. It will not run here.
    echo "⚠️  Wally is x86_64-only; the binary installed below will not run on {{ $arch }}."
    {{- end }}
    sudo mv wally /usr/local/bin/wally
    sudo chmod a+x /usr/local/bin/wally
  {{- end }}
)
optional_runner install_moonlander
{{- end }}

