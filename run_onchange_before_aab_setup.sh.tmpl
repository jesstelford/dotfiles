# golang
install_golang() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    # brew keeps Go current; avoids pinning a pkg URL that rots
    brew install go
  {{- else if (eq .chezmoi.os "linux") }}
    use_temp_dir
    # Resolve the latest stable Go release so this doesn't rot to a pinned version
    GO_VERSION="$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -n1)"
    GO_TARBALL="${GO_VERSION}.linux-{{ $arch }}.tar.gz"

    # This one is deliberately not pinned, so its digest can't be pinned either.
    # Go publishes the SHA-256 of every release file in its own download index,
    # so fetch that alongside the tarball and check against it. Same TLS trust
    # root as the download itself, so it is not a defence against a compromised
    # go.dev — it is a defence against a corrupted or substituted mirror
    # response, which is the realistic failure here.
    #
    # `include=all` so a brand-new release that hasn't rolled onto the default
    # (stable-only) listing yet still resolves.
    GO_SHA256="$(curl -fsSL 'https://go.dev/dl/?mode=json&include=all' \
      | grep -A5 "\"filename\": \"${GO_TARBALL}\"" \
      | grep '"sha256"' \
      | head -n1 \
      | cut -d'"' -f4)"

    if [ -z "$GO_SHA256" ]; then
      echo "❌ No published SHA-256 for ${GO_TARBALL}; refusing to install it unverified."
      exit 1
    fi

    wget --no-verbose "https://go.dev/dl/${GO_TARBALL}"
    verify_sha256 "./${GO_TARBALL}" "$GO_SHA256"
    # Remove any previous install before extracting, per the official upgrade docs
    sudo rm -rf /usr/local/go
    sudo tar -C /usr/local -xzf "${GO_TARBALL}"
    rm -f "${GO_TARBALL}"
  {{- end }}
)
runner install_golang

