{{- if .islocalenv }}
# fontforge for patching Input Mono later
install_fontforge() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    install_dmg https://github.com/fontforge/fontforge/releases/download/{{ .versions.fontforge }}/FontForge-{{ .versions.fontforge_build }}.app.dmg
  {{- else if (eq .chezmoi.os "linux") }}
    {{- if eq $arch "amd64" }}
      use_temp_dir
      wget --no-verbose https://github.com/fontforge/fontforge/releases/download/{{ .versions.fontforge }}/FontForge-{{ .versions.fontforge_build }}-x86_64.AppImage
      sudo mv FontForge-{{ .versions.fontforge_build }}-x86_64.AppImage /usr/local/bin
      sudo chmod a+x /usr/local/bin/FontForge-{{ .versions.fontforge_build }}-x86_64.AppImage
      # rm -f first: `ln -s` onto an existing symlink is an error, which would
      # abort this step on every re-run (same idiom as install_fd below)
      sudo rm -f /usr/local/bin/fontforge
      sudo ln -s /usr/local/bin/FontForge-{{ .versions.fontforge_build }}-x86_64.AppImage /usr/local/bin/fontforge
    {{- else }}
      # FontForge only ever published an x86_64 AppImage, so on {{ $arch }} use
      # the distro package. install_fonts just needs a `fontforge` on PATH.
      apt_get install fontforge
    {{- end }}
  {{- end }}
)
runner install_fontforge
{{- end }}

{{- if .islocalenv }}
install_fonts() (
  set -e
  # Patch fonts for use with powerlevel10k
  # https://github.com/ryanoasis/nerd-fonts/issues/400#issuecomment-687229777
  # Do a sparse-checkout of only the files we need.
  #
  # This is a mandatory runner, so an unguarded `git clone` meant the second and
  # every subsequent run died right here with "destination path already exists"
  # — i.e. the fonts could never be re-patched or updated. Same guard as
  # install_fzf / install_powerlevel10k / the zsh plugins above.
  if [ -d "$HOME/dev/nerd-fonts" ]; then
    cd "$HOME/dev/nerd-fonts"
    git pull
  else
    git clone https://github.com/ryanoasis/nerd-fonts.git --depth 1 --filter=blob:none --sparse $HOME/dev/nerd-fonts
    cd $HOME/dev/nerd-fonts
  fi
  git sparse-checkout set --no-cone /src/glyphs /font-patcher
  sudo chmod a+x font-patcher

  # Install some custom fonts

  # temporary directory to extract fonts to
  mkdir -p fonts

  # Lato Font (for RoamResearch theme)
  # NOTE: the opener is templated per-OS: `open` is macOS-only, and this
  # function used to call it on Linux too, where it aborted the whole step.
  {{ $open }} 'https://fonts.google.com/download?family=Lato'
  read -p "Once download complete, press y: " x;
  # -o: never stop to ask "replace ...? [y]es, [n]o, [A]ll". chezmoi wires this
  # script's stdin through, so an unanswered unzip prompt hangs the whole apply.
  # -q: the file list is noise.
  unzip -o -q ~/Downloads/Lato.zip -d ./fonts
  rm -f ~/Downloads/Lato.zip

  # Open Sans Font (for RoamResearch theme)
  {{ $open }} 'https://fonts.google.com/download?family=Open%20Sans'
  read -p "Once download complete, press y: " x;
  unzip -o -q ~/Downloads/Open_Sans.zip -d ./fonts
  rm -f ~/Downloads/Open_Sans.zip

  # InputMono Font
  curl "https://input.djr.com/build/?fontSelection=whole&a=0&g=0&i=0&l=0&zero=0&asterisk=0&braces=0&preset=default&line-height=1.2&accept=I+do&email=" -sSLo InputMono-Font.zip
  unzip -o -q InputMono-Font.zip -d InputMono-Font
  # -f: on a re-run these .ttf files already exist in fonts/, and an
  # unanswerable "override ...?" prompt would hang the apply
  mv -f InputMono-Font/Input_Fonts/InputMono/InputMono/InputMono-*.ttf fonts
  rm -rf InputMono-Font InputMono-Font.zip

  # Patch Input Mono font for use with powerlevel10k
  # https://github.com/ryanoasis/nerd-fonts/issues/400#issuecomment-687229777
  # Prepare the output folder
  mkdir -p fonts/InputMono-NerdFont/
  {{- if (eq .chezmoi.os "darwin") }}
    # Required deps. See: https://github.com/FontCustom/fontcustom/issues/382
    brew tap bramstein/webfonttools
    brew install woff2 sfnt2woff eot-utils

    # Patch the fonts
    find fonts/ -maxdepth 1 -name 'InputMono*.ttf' | parallel -j $(nproc) /Applications/FontForge.app/Contents/MacOS/FontForge -script font-patcher --no-progressbars --careful --complete --makegroups 0 --outputdir fonts/InputMono-NerdFont {} \;
  {{- else if (eq .chezmoi.os "linux") }}
    # Patch the fonts
    find fonts/ -maxdepth 1 -name 'InputMono*.ttf' | parallel -j $(nproc) fontforge -script font-patcher --no-progressbars --careful --complete --makegroups 0 --outputdir fonts/InputMono-NerdFont {} \;
  {{- end }}

  {{- if (eq .chezmoi.os "linux") }}
    # Get the latest emoji font for Ubuntu.
    # -O rather than -P: wget won't overwrite, so `-P fonts` left a second copy
    # as fonts/NotoColorEmoji.ttf.1 on every re-run and the stale original was
    # the one that got installed.
    wget --no-verbose -O fonts/NotoColorEmoji.ttf https://github.com/googlefonts/noto-emoji/raw/main/fonts/NotoColorEmoji.ttf
  {{- end }}

  # Move all the fonts into the correct directory
  {{- if (eq .chezmoi.os "darwin") }}
    mkdir -p $HOME/Library/Fonts
    cp -r fonts/* $HOME/Library/Fonts
  {{- else if (eq .chezmoi.os "linux") }}
    mkdir -p $HOME/.fonts
    cp -r fonts/* $HOME/.fonts

    # NOTE: No sudo; we want to update the current user's font cache
    fc-cache -f -v
  {{- end }}
)
runner install_fonts
{{- end }}

# fnm (node version manager)
#
# Deliberately NOT gated on .islocalenv: with Spin gone, fnm is the only way
# node gets installed, and install_node / .zshrc both call it unconditionally.
# Gating it here is what broke node in codespaces and CI.
install_fnm() (
  set -e
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --force-install --skip-shell --install-dir $HOME/.fnm
  # Install the shell completions manually for zsh (because this script is run
  # in bash on first install by chezmoi)
  mkdir -p $HOME/.zsh/completion
  $HOME/.fnm/fnm completions --shell zsh > $HOME/.zsh/completion/_fnm
)
runner install_fnm

if [ -f "$HOME/.fnm/fnm" ];
then
  # Ensure fnm's executable, etc, is loaded into the current environment so we
  # can run it in the following commands
  eval "$($HOME/.fnm/fnm env)"
fi

# node
install_node() (
  set -e
  $HOME/.fnm/fnm install v{{ .versions.node }}
  $HOME/.fnm/fnm default v{{ .versions.node }}
)
runner install_node

# yarn
install_yarn() (
  set -e
  npm install --global yarn
)
optional_runner install_yarn

