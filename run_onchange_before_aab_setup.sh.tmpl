      `dbeaver-ce-26.1.3-linux-x86_64.deb` — underscores to hyphens, dpkg arch
      names to GNU triplet names.

      The pin and its digest both live in .chezmoidata.toml; refresh them
      together with the `curl` snippet in the header of that file.
    */}}
    use_temp_dir
    wget --no-verbose https://github.com/dbeaver/dbeaver/releases/download/{{ .versions.dbeaver }}/dbeaver-ce-{{ .versions.dbeaver }}-linux-{{ $archgnu }}.deb
    verify_sha256 ./dbeaver-ce-{{ .versions.dbeaver }}-linux-{{ $archgnu }}.deb {{ index .digests.dbeaver $arch }}
