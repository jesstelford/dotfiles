    # The .deb filename here was hardcoded to _amd64 regardless of machine, so
    # on {{ $arch }} this downloaded a package dpkg then refused to install.
    # Upstream published no arm64 build of this release, so say so and stop.
    skip "Skipping Roam Research: upstream publishes no Linux {{ $arch }} build."
