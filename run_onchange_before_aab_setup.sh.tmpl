#!/usr/bin/env bash

# IMPORTANT: This file must be idempotent because we don't know when/if it'll
# be re-run.

{{- /*
  Architecture matrix.

  .chezmoi.arch is Go's GOARCH — "amd64" or "arm64" on every machine this repo
  targets — and it was previously used nowhere at all. Instead each download
  hardcoded an architecture, and they disagreed: Neovim assumed arm64 while
  bat, delta, Go, mkcert, lua-language-server and the apt sources on the very
  same Linux host assumed amd64, so at least one group was always wrong.

  Four upstream spellings are in play, so derive all of them once, here:

    $arch      amd64  | arm64     dpkg / .deb assets / Go's own tarballs
    $archnvim  x86_64 | arm64     Neovim release assets
    $archlua   x64    | arm64     lua-language-server release assets
    $archgnu   x86_64 | aarch64   GNU triplet spelling; DBeaver release assets

  A handful of downloads (Signal for Linux, Roam Research) only ever published
  an x86_64 build; those are called out individually below and bail out cleanly
  rather than being silently wrong.
*/}}
{{- $arch := .chezmoi.arch }}
{{- $archnvim := $arch }}
{{- $archlua := $arch }}
{{- $archgnu := "aarch64" }}
{{- if eq $arch "amd64" }}
{{-   $archnvim = "x86_64" }}
{{-   $archlua = "x64" }}
{{-   $archgnu = "x86_64" }}
{{- end }}

{{- /*
  Download integrity.

  Every download below arrives over TLS, which authenticates the host and says
  nothing whatsoever about the bytes. A hijacked release asset, a compromised
  bucket or a tampering mirror all still hand back a 200 — and several of these
  files are then unpacked into /usr/local or handed to `apt-get install` as
  root. So: where a download is pinned to a version, the SHA-256 of that exact
  asset is pinned next to it and checked before anything is installed.

  Both the pins and their digests live in .chezmoidata.toml, per-arch where
  upstream publishes a per-arch asset, so a version bump and its digests are one
  contiguous edit in one file rather than edits in two places that can drift
  apart — and so this script stays splittable per domain without scattering
  them. That file's header documents how to refresh a digest without
  downloading anything, and where the current values came from.

  Rolling "latest" URLs (Brave, Discord, Rocket, 1Password, Wally for macOS)
  cannot be pinned by construction and are left unverified; installing those
  from Homebrew casks instead would fix that, and is the obvious follow-up.
*/}}

{{- /* Opening a URL in the desktop browser: `open` is macOS-only */}}
{{- $open := "open" }}
{{- if (eq .chezmoi.os "linux") }}
{{-   $open = "xdg-open" }}
{{- end }}

# ---------------------------------------------------------------------------
# Step results.
#
# Every install step below is wrapped in `runner` or `optional_runner`, and both
# used to END on:
#
#     [[ $? -eq 0 ]] && echo "✅ $1" || echo "❌ $1"
#
# `echo` always succeeds, so the `&&` branch always ran, so BOTH functions
# always returned 0. There is no top-level `set -e` here and the last statement
# in this file is an `echo`, so the script as a whole also always exited 0.
#
# That is not cosmetic. chezmoi persists a `run_onchange_` script's state entry
# only when the script exits 0 — so a run where half the steps blew up was
# recorded as DONE and never retried. The next `chezmoi apply` saw an unchanged
# script hash, skipped it, and the machine stayed half-provisioned forever with
# a wall of green ticks in the scrollback.
#
# So: capture the status before printing anything (an `echo` clobbers `$?`),
# print a marker, RETURN the status, remember the name, and exit non-zero at the
# end of the file if anything failed.
# ---------------------------------------------------------------------------

# Names of steps that failed / were deliberately skipped, for the summary at the
# end. Populated by `runner`; these are plain shell arrays, and `runner` is
# called in the current shell (never a subshell), so the appends stick.
failed_steps=()
skipped_steps=()

# The exit status a step uses to say "I deliberately did nothing". It has to be
# distinct from 0, or a skip renders as a success tick, and distinct from a real
# failure, or a skip fails the whole run. Several steps below used to `exit 0`
# after printing a "Skipping ..." message and so were reported as ✅.
#
# 90 is outside every range anything here produces: 1-2 are generic shell/usage
# errors, 64-78 are sysexits.h, 126-165 are "not executable"/"killed by signal".
step_skipped=90

# Print a reason and end the current step as SKIPPED rather than as a success.
# Only valid inside a step subshell — `exit` ends that subshell, not the script.
#
# Usage: skip "Upstream publishes no linux/arm64 build."
skip() {
  echo "$@"
  exit "$step_skipped"
}

# A runner for functions which perform actions, resulting in clean output for
# successful runs.
# Usage:
#
# # Note the '(' is important: It makes this a subshell so it can return with an
# # exit code when `set -e` is set.
# example_func() (
#   # This is important to ensure this subshell exits with a code when any
#   # commands fail
#   set -e
#   echo "Some pre-execution output: $1"
#   false
#   # true
#   echo "Things have happened"
# )
#
# # Execute the `example_func` function, showing a success/failure/skipped
# # message and recording the outcome for the summary at the end of the run.
# runner example_func "An example argument"

runner() {
  local status

  echo ""
  echo "Running $1..."

  # 1. $@ is all the arguments passed to this function
  # 2. Executing "$@" will execute it like a command to bash. Ie; if the
  #    arguments are [echo "foo"], it will execute `echo "foo"`
  "$@"

  # Grab the status FIRST. It lives in $? and $? is overwritten by the very next
  # command — including by the `echo` that used to be tested against it.
  #
  # This is only meaningful because each step is a subshell, ie; some_func() (
  # ... ) with '(' instead of '{', which lets the step `set -e` and exit with a
  # status of its own.
  status=$?

  case "$status" in
    0)                 echo "✅ $1" ;;
    "$step_skipped")   echo "⏭️  Skipped $1"; skipped_steps+=("$1") ;;
    *)                 echo "❌ $1 (exit $status)"; failed_steps+=("$1") ;;
  esac

  return "$status"
}

optional_runner() {
  local answer

  echo ""

  # -r so a backslash in the answer isn't eaten.
  #
  # `|| answer=n` because `read` returns non-zero at EOF, which is what happens
  # on every single prompt when stdin is /dev/null or a closed pipe (CI, a
  # non-interactive `chezmoi apply`). Without it the old unquoted
  # `if [ $x = "y" ]` expanded to `[ = y ]` and printed
  # "[: =: unary operator expected" — which is also what you got locally just by
  # pressing Enter.
  #
  # The case arm accepts the spellings people actually type; the old test
  # matched a bare lowercase "y" and nothing else, so "Y" and "yes" were
  # silently treated as "no".
  read -r -p "[Optional] Run $1? [y/N]: " answer || answer=n

  case "${answer:-n}" in
    y | Y | yes | Yes | YES)
      runner "$@"
      ;;
    *)
      echo "⏭️  Skipped $1 (declined)"
      skipped_steps+=("$1")
      ;;
  esac
}

# Move the current shell into a fresh, empty, throwaway directory.
#
# chezmoi runs these scripts with the cwd set to $HOME, so every bare
# `wget <url>` below used to download straight into the home directory. That is
# not just untidy, it is wrong on a re-run: wget refuses to overwrite and writes
# `foo.deb.1` instead, while the install line right underneath keeps consuming
# the STALE `foo.deb` from the first run forever.
#
# Call this at the top of a downloading step. Every step is a `( ... )` subshell
# (see the `runner` docs above), so the `cd` is contained to that one step and
# cannot leak into the next.
#
# The 755 matters on Linux: apt-get drops to the unprivileged `_apt` user to
# read a local .deb, and mktemp -d creates the directory as 0700.
use_temp_dir() {
  local dir
  dir="$(mktemp -d)"
  chmod 755 "$dir"
  cd "$dir"
}

# Check a downloaded file against its pinned SHA-256 before anything is done
# with it. See the "Download integrity" note at the top of this file for why.
#
# Returns non-zero on a mismatch, which -- because every install step is a
# `( set -e ... )` subshell -- aborts that step before the bad bytes are
# installed, and the `runner` wrapper reports it as a failure.
#
# `shasum -a 256` is the portable spelling: macOS ships it and no `sha256sum`,
# Linux ships `sha256sum` and usually (not always) `shasum`. Prefer whichever
# is present.
#
# Usage:
# verify_sha256 ./bat_0.25.0_amd64.deb 7e6afdff...
verify_sha256() {
  local file="$1"
  local expected="$2"
  local actual

  if command -v sha256sum > /dev/null 2>&1; then
    actual="$(sha256sum "$file" | cut -d' ' -f1)"
  elif command -v shasum > /dev/null 2>&1; then
    actual="$(shasum -a 256 "$file" | cut -d' ' -f1)"
  else
    echo "❌ Neither sha256sum nor shasum found; refusing to install $file unverified."
    return 1
  fi

  if [ "$actual" != "$expected" ]; then
    echo "❌ Checksum mismatch for $file"
    echo "   expected: $expected"
    echo "   actual:   $actual"
    echo "   Refusing to install it. If upstream legitimately re-cut this"
    echo "   release, update the pinned digest in this script deliberately."
    return 1
  fi
}

{{- /* Use for doing different things on different machines

{{- if not .islocalenv }}
# Setup for codespaces / CI
{{- else if (eq .chezmoi.os "darwin") }}
# Setup for MacOS
{{- else if (eq .chezmoi.os "linux") }}
# Setup for linux
{{- end }}

*/}}

{{- /* Use for doing different things on different machines

{{- if (or (.codespaces) (eq .chezmoi.os "linux")) }}
# Setup for Linux or codespaces
{{- else if (eq .chezmoi.os "darwin") }}
# Setup for MacOS
{{- end }}

*/}}

{{- if (or (.codespaces) (eq .chezmoi.os "linux")) }}
  # Run apt with some default options
  # NOTE: This is running as a subshell '(' so we can use 'set -e' to bail
  # immediately from the function if anything errors.
  #
  # Usage:
  # apt_get install ./foo-bar.deb
  apt_get() (
    set -e
    sudo apt-get -o DPkg::Lock::Timeout=60 -q=2 --yes "$@"
  )
{{- else if (eq .chezmoi.os "darwin") }}
  # Ensure homebrew is available on the path for following commands
  # Necessary because this script is run before chezmoi copies dotfiles
  # (normally this lives in the .bash_profile)
  #
  # Homebrew's prefix is /opt/homebrew on Apple Silicon but /usr/local on Intel,
  # so probe both. This runs at file scope where there is no `set -e`, so a
  # wrong guess used to fail silently here and then take down every `brew
  # install` below it — say so loudly instead.
  if brew_shellenv="$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null)"; then
    eval "$brew_shellenv"
  else
    echo "❌ No brew in /opt/homebrew or /usr/local; every brew step below will fail."
  fi

  # Install a .dmg file into the /Applications directory
  # NOTE: This is running as a subshell '(' so we can use 'set -e' to bail
  # immediately from the function if anything errors.
  #
  # $2, when given, is the expected SHA-256 of the .dmg and is checked before
  # the image is mounted. It is optional because several of these downloads
  # resolve to a rolling "latest" URL, which cannot be pinned at all.
  #
  # The "pkg" strategy this used to carry had exactly one caller,
  # Karabiner-Elements, which is a Homebrew cask now. Dead branches in a
  # privileged installer are not worth keeping around on spec.
  #
  # Usage:
  # install_dmg https://referrals.brave.com/latest/Brave-Browser.dmg
  # install_dmg https://example.com/pinned-1.2.3.dmg deadbeef...
  install_dmg() (
    set -e
    # Download into a throwaway directory rather than ~/installer.dmg: `set -e`
    # means a failed mount skips the `rm -f` below and leaves the .dmg sitting in
    # the home directory forever.
    use_temp_dir
    wget --no-verbose "$1" -O ./installer.dmg
    if [ -n "${2:-}" ]; then
      verify_sha256 ./installer.dmg "$2"
    fi
    # Mount the .dmg and capture the directory it mounted to
    MOUNTDIR=$(echo `hdiutil mount ./installer.dmg | tail -1 | awk '{$1=$2=""; print $0}'` | xargs -0 echo)
    # Copy out the .app file to /Applications
    sudo cp -R "${MOUNTDIR}"/*.app /Applications
    # Cleanup
    hdiutil unmount "$MOUNTDIR"
    rm -f ./installer.dmg
  )
{{- end }}

install_dev_deps() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install wget git findutils coreutils parallel tree patchutils
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get update
    # Baseline tools the rest of this script assumes exist. None of them are
    # guaranteed on a minimal Ubuntu image or a devcontainer:
    #   wget                      - how nearly every download below is fetched
    #   unzip                     - fonts, PICO-8, 1Password
    #   patchutils                - lsdiff, for parity with the macOS branch
    #   software-properties-common - add-apt-repository, used on the next line
    apt_get install wget unzip patchutils software-properties-common
    # latest git
    # -y because this also runs unattended in CI/codespaces, where the
    # "press [ENTER] to continue" prompt has no one to answer it.
    sudo add-apt-repository -y ppa:git-core/ppa
    apt_get update
    apt_get install git
    {{- if .islocalenv }}
      apt_get install parallel
    {{- end }}
    # Ubuntu 22.04 no longer ships with libfuse2, which is required by the
    # Neovim AppImage. See: https://askubuntu.com/a/1404084
    #
    # This used to be an unquoted `libfuse2*`. Two things wrong with that:
    #   - the glob is unquoted, so if a file matching it happened to exist in
    #     the cwd the shell would expand it away before apt ever saw it;
    #   - apt only treats an argument as a *regex* when it matches no package
    #     name literally, and `libfuse2*` does not, so it fell through to regex
    #     matching. As a regex `libfuse2*` means "libfuse" then zero-or-more
    #     "2"s, unanchored -- which matches libfuse-dev, libfuse3-3, libfuse3-dev
    #     and friends, and pulled the lot in.
    # 24.04 renamed the package to libfuse2t64 as part of the 64-bit time_t
    # transition, so pick by what the release actually has rather than globbing.
    if apt-cache show libfuse2t64 > /dev/null 2>&1; then
      apt_get install libfuse2t64
    else
      apt_get install libfuse2
    fi
  {{- end }}
)
runner install_dev_deps

# Some prep for ZSH
mkdir -p $HOME/.zsh
# sudo: on a fresh macOS /usr/local/bin does not exist yet and /usr/local is
# root-owned, so an unprivileged mkdir fails here — and then every `sudo tee` and
# `ln -s` into that directory further down fails too.
sudo mkdir -p /usr/local/bin

install_zsh() (
  set -e
  # Install it
  {{- if (eq .chezmoi.os "darwin") }}
    brew install zsh
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install zsh
  {{- end }}
  # Use root to set the default shell for my user. Required when my user doesn't have permissions.
  sudo chsh -s $(which zsh) $(whoami)
)
runner install_zsh

# Add git absorb command: https://github.com/tummychow/git-absorb
install_git_absorb() (
  set -e
  # Install it
  {{- if (eq .chezmoi.os "darwin") }}
    brew install git-absorb
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install git-absorb
  {{- end }}
)
runner install_git_absorb

# git-lfs
#
# .gitconfig declares `[filter "lfs"] required = true`, which makes git hard-fail
# on any clone of an LFS repo when the git-lfs binary is missing. Install it here
# rather than leaving it as a manual step.
#
# Deliberately no `git lfs install`: that command's only job is to write the
# `[filter "lfs"]` block into ~/.gitconfig, which is chezmoi-managed and already
# contains it verbatim. Running it here (this script runs *before* chezmoi writes
# the dotfiles) would only churn a managed file.
install_git_lfs() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install git-lfs
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install git-lfs
  {{- end }}
)
runner install_git_lfs

# rg / ripgrep
install_ripgrep() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    brew install ripgrep
  {{- else if (eq .chezmoi.os "linux") }}
    apt_get install ripgrep
  {{- end }}
)
runner install_ripgrep

{{- if (eq .chezmoi.os "darwin") }}
# fzf
install_fzf() (
  set -e
  # brew puts fzf on PATH and keeps it current; shell integration comes from
  # `fzf --zsh` (sourced in .zshrc)
  brew install fzf
)
runner install_fzf
{{- else }}
{{- /* Everywhere else fzf is the ~/.fzf git-repo external in
       .chezmoiexternal.toml, and run_after_fzf-binary.sh downloads the
       matching binary once that checkout exists. */}}
{{- end }}

# neovim
install_neovim() (
  set -e
  use_temp_dir
  {{- $nvimbinary := "" }}
  {{- $nvimversion := .versions.nvim }}
  {{- if (eq .chezmoi.os "darwin") }}
    if [ ! -d "/usr/local/nvim-osx64-{{ $nvimversion }}" ]; then
      wget --no-verbose https://github.com/neovim/neovim/releases/download/v{{ $nvimversion }}/nvim-macos-{{ $archnvim }}.tar.gz
      # There used to be an `xattr -c` here, described as avoiding the "unknown
      # developer" warning. What it actually did was strip com.apple.quarantine
      # so Gatekeeper would not evaluate a binary that is then `sudo mv`d into
      # /usr/local and put on PATH as `nvim` — i.e. it disabled the one check
      # standing between a bad download and root-owned code execution.
      #
      # The pinned digest below is the honest version of that: it says exactly
      # which bytes are expected. Whatever Gatekeeper wants to say about them
      # afterwards, it now gets to say — accept the one-time prompt.
      verify_sha256 ./nvim-macos-{{ $archnvim }}.tar.gz {{ index .digests.nvim_macos $arch }}
      tar xzvf nvim-macos-{{ $archnvim }}.tar.gz
      sudo mv ./nvim-macos-{{ $archnvim }} /usr/local/nvim-osx64-{{ $nvimversion }}
    fi
    {{- /* printf, not a nested "{{ }}" inside the string: template actions are
           not re-evaluated, so the literal would survive into the script. */}}
    {{- $nvimbinary = printf "/usr/local/nvim-osx64-%s/bin/nvim" $nvimversion }}
  {{- else if (eq .chezmoi.os "linux") }}
    if [ ! -f "/usr/local/bin/nvim-{{ $nvimversion }}.appimage" ]; then
      wget --no-verbose https://github.com/neovim/neovim/releases/download/v{{ $nvimversion }}/nvim-linux-{{ $archnvim }}.appimage
      verify_sha256 ./nvim-linux-{{ $archnvim }}.appimage {{ index .digests.nvim_linux $arch }}
      sudo mv nvim-linux-{{ $archnvim }}.appimage /usr/local/bin/nvim-{{ $nvimversion }}.appimage
    fi
    {{- $nvimbinary = printf "/usr/local/bin/nvim-%s.appimage" $nvimversion }}
  {{- end }}

  {{- /* Ghostty is the terminal now; it ships the xterm-ghostty terminfo. */}}
  {{- $term := "xterm-ghostty" }}

  sudo chmod a+x {{ $nvimbinary }}

  sudo rm -f /usr/local/bin/nvim
  sudo tee -a /usr/local/bin/nvim > /dev/null <<EOF
#!/usr/bin/env bash
# Explicitly set the terminal here so nvim knows it is running inside
# {{ $term }} (necessary when running inside tmux, which advertises its own
# TERM). Environments without that terminfo -- codespaces and CI never install
# Ghostty -- keep whatever TERM they already had rather than getting an unknown
# one.
term={{ $term }}
if ! infocmp "\$term" > /dev/null 2>&1; then
  term="\$TERM"
fi
if test \$# -gt 0; then
  TERM="\$term" {{ $nvimbinary }} "\$@"
else
  TERM="\$term" {{ $nvimbinary }}
fi
EOF
  sudo chmod a+x /usr/local/bin/nvim
)
runner install_neovim

{{- if .islocalenv }}
# Brave browser
install_brave() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    install_dmg https://referrals.brave.com/latest/Brave-Browser.dmg
  {{- else if (eq .chezmoi.os "linux") }}
    # see: https://brave.com/linux/
    apt_get install apt-transport-https curl
    sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg arch={{ $arch }}] https://brave-browser-apt-release.s3.brave.com/ stable main"|sudo tee /etc/apt/sources.list.d/brave-browser-release.list
    apt_get update
    apt_get install brave-browser

    # Set brave as the default browser
    sudo update-alternatives --config x-www-browser
    sudo update-alternatives --config gnome-www-browser
    xdg-settings set default-web-browser brave-browser.desktop
  {{- end }}
)
runner install_brave
{{- end }}
