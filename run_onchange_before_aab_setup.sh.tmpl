{{- if .islocalenv }}
# mongoDB
install_mongodb() (
  set -e
  {{- if (eq .chezmoi.os "darwin") }}
    # TODO
  {{- else if (eq .chezmoi.os "linux") }}
    # From https://www.mongodb.com/docs/manual/tutorial/install-mongodb-on-ubuntu/
    #
    # Bumped from 4.4/focal. 4.4 reached end of life in February 2024 and the
    # focal index it came from is for Ubuntu 20.04 — this step carried its own
    # "NOTE: TODO: FIXME: Only for Ubuntu 20.04" admitting as much. On anything
    # newer, apt would 404 on that index and then fail *every* later
    # `apt update` on the machine, not just this step.
    #
    # The exact-version pins (=4.4.5) and the five `dpkg --set-selections` holds
    # are gone with it. Holding a package at one patch release is precisely what
    # let this rot silently for four years, and nothing here needs a specific
    # patch — {{ .versions.mongodb }} is the current GA series and apt can keep it
    # current on its own.
    apt_get install gnupg lsb-release

    # A previous run of this script left a dead 4.4/focal source behind. apt
    # fails the whole `update` when any single index 404s, so a machine that ran
    # the old version of this step has a broken apt until this is removed.
    sudo rm -f /etc/apt/sources.list.d/mongodb-org-4.4.list /usr/share/keyrings/mongodb-server-4.4.gpg

    # MongoDB publishes per-release indexes, and only for Ubuntu LTS codenames.
    # Pointing apt at one that does not exist breaks apt globally (see above),
    # so fall back to the newest supported LTS on a non-LTS or newer release.
    mongo_codename="$(lsb_release -cs)"
    case "$mongo_codename" in
      jammy|noble) ;;
      *)
        echo "No MongoDB {{ .versions.mongodb }} index for '$mongo_codename'; using the noble one."
        mongo_codename=noble
        ;;
    esac

    # apt-key is deprecated/removed on modern Ubuntu; use a signed-by keyring.
    # Truncating `tee` rather than `gpg -o`, which refuses to overwrite an
    # existing file and would fail every re-run.
    wget -qO- https://www.mongodb.org/static/pgp/server-{{ .versions.mongodb }}.asc \
      | gpg --dearmor \
      | sudo tee /usr/share/keyrings/mongodb-server-{{ .versions.mongodb }}.gpg > /dev/null
    # apt reads the keyring as the unprivileged `_apt` user
    sudo chmod go+r /usr/share/keyrings/mongodb-server-{{ .versions.mongodb }}.gpg

    echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-{{ .versions.mongodb }}.gpg ] https://repo.mongodb.org/apt/ubuntu ${mongo_codename}/mongodb-org/{{ .versions.mongodb }} multiverse" \
      | sudo tee /etc/apt/sources.list.d/mongodb-org-{{ .versions.mongodb }}.list > /dev/null
    apt_get update

    # Ubuntu's own `mongodb*` packages conflict with mongodb-org. Remove them
    # only when actually installed: `apt-get remove` on a name that is not in
    # the index at all is a hard error, and under `set -e` that aborted this
    # whole step. The old line named `mongo-tools`, which has not existed as an
    # Ubuntu package since 18.04.
    for pkg in mongodb mongodb-clients mongodb-server mongodb-server-core; do
      if dpkg -s "$pkg" > /dev/null 2>&1; then
        apt_get remove "$pkg"
      fi
    done

    apt_get install mongodb-org

    # Mongo not working? Probably because there are old databases that can't be
    # upgraded directly to this version, so we have to either delete the physical
    # database file or rollback mongo version to oldver+1, run the daemon, then
    # upgrade to the next version etc. :(
    # Going 4.4 -> {{ .versions.mongodb }} is several such hops; an existing dbpath
    # from the old pin will not start under {{ .versions.mongodb }} without them.
  {{- end }}
)
optional_runner install_mongodb
{{- end }}

