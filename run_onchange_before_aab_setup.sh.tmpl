# Signal messenger
install_signal() (
  set -e
  {{- if .codespaces }}
    # Not on Codespaces
  {{- else if (eq .chezmoi.os "darwin") }}
    install_dmg https://updates.signal.org/desktop/signal-desktop-mac-universal-{{ .versions.signal }}.dmg
  {{- else if (eq .chezmoi.os "linux") }}
    {{- if ne $arch "amd64" }}
    # Signal Desktop for Linux is published for amd64 only. Adding the repo
    # anyway would leave every subsequent `apt update` failing on a missing
    # {{ $arch }} index, so bail out cleanly instead.
    echo "Skipping Signal: upstream publishes no Linux {{ $arch }} build."
    exit 0
    {{- else }}
    use_temp_dir
    # Both of these used to be `tee -a`. Appending a second copy of the dearmored
    # key to an existing binary keyring corrupts it, and appending the same `deb`
    # line again makes every later `apt update` warn about a duplicate source.
    # Truncating `tee` (the idiom used by install_brave / install_gh above) makes
    # a re-run a no-op instead.
    wget -qO- https://updates.signal.org/desktop/apt/keys.asc | gpg --dearmor > signal-desktop-keyring.gpg
    sudo tee /usr/share/keyrings/signal-desktop-keyring.gpg < signal-desktop-keyring.gpg > /dev/null
    # apt reads the keyring as the unprivileged `_apt` user
    sudo chmod go+r /usr/share/keyrings/signal-desktop-keyring.gpg

    echo "deb [arch={{ $arch }} signed-by=/usr/share/keyrings/signal-desktop-keyring.gpg] https://updates.signal.org/desktop/apt `lsb_release -cs` main" | sudo tee /etc/apt/sources.list.d/signal-`lsb_release -cs`.list

    apt_get update && apt_get install signal-desktop
    {{- end }}
  {{- end }}
)
optional_runner install_signal
{{- end }}

{{- if .islocalenv }}
# PICO-8
install_pico8() (
  set -e
  {{- if .codespaces }}
    # Not on Codespaces
  {{- else }}

  {{- $pico8platform := "" }}
  {{- if (eq .chezmoi.os "darwin") }}
    {{- $pico8platform = "osx" }}
  {{- else if (eq .chezmoi.os "linux") }}
    {{- $pico8platform = "linux64" }}
  {{- end }}
  {{- $pico8zip := "/tmp/pico-8.zip" }}

  # Get credentials out of 1password.
  #
  # Deliberately fetched here at run time rather than with chezmoi's
  # onepassword* template functions. Those run while chezmoi *renders* this
  # script, which would mean a brand new machine couldn't apply at all until
  # the 1Password CLI was installed and signed in — and the CLI is installed
  # by this very script, so there was no way to bootstrap out of it.
  ITCH_ITEM="kz6tex4nh5fx7a2kvohdx6tt4e"

  # The CLI is installed by install_one_password_cli earlier in this run, but
  # that step is optional and may have been declined — so install it on demand
  # rather than making this a manual step in the middle of an automated setup.
  if ! command -v op > /dev/null 2>&1; then
    echo "1Password CLI not found, installing it first..."
    install_one_password_cli
  fi

  if ! command -v op > /dev/null 2>&1; then
    echo "Skipping PICO-8: the 1Password CLI ('op') still isn't on PATH, so the"
    echo "itch.io credentials can't be read."
    exit 0
  fi

  # A single fetch doubles as the signed-in check: if the session is locked or
  # missing, 'op' fails here rather than part way through the download.
  #
  # Signing in is the one part that can't be automated — it needs the account
  # password or biometrics — so prompt for it rather than bailing out.
  if ! ITCH_USERNAME="$(op item get "$ITCH_ITEM" --fields label=username --reveal 2> /dev/null)"; then
    echo "1Password is locked or not signed in. Signing in now..."
    eval "$(op signin)" || true
  fi

  if ! ITCH_USERNAME="$(op item get "$ITCH_ITEM" --fields label=username --reveal 2> /dev/null)"; then
    echo "Skipping PICO-8: couldn't read the itch.io credentials from 1Password."
    echo "Run 'op signin' by hand, then re-run 'chezmoi apply'."
    exit 0
  fi
  ITCH_PASSWORD="$(op item get "$ITCH_ITEM" --fields label=password --reveal)"

  # Exported rather than inlined into the npx command so the password stays out
  # of the process list, where 'ps' would show it to any other user.
  export DEST_FILE={{ $pico8zip }}
  export PLATFORM={{ $pico8platform }}
  export USERNAME="$ITCH_USERNAME"
  export PASSWORD="$ITCH_PASSWORD"

  # Download the binary
  #
  # The helper is copied from the chezmoi *source* directory, not from $HOME:
  # .chezmoiignore ignores 'scripts/', so ~/scripts/install-pico8.js has never
  # existed and the old relative 'scripts/install-pico8.js' could never resolve.
  npx --package=playwright@~{{ .versions.playwright }} --yes -c 'dir=$(dirname `which playwright`)/../..; cp "{{ .chezmoi.sourceDir }}/scripts/install-pico8.js" "$dir"; cd "$dir"; node install-pico8.js'

  # Install it
  {{- if (eq .chezmoi.os "darwin") }}
    # -o: /tmp/pico-8 survives from the previous run, and an unzip overwrite
    # prompt hangs the whole apply (chezmoi passes stdin through). Unpack into a
    # fresh directory so there is nothing half-extracted to trip over either.
    PICO8_DIR="$(mktemp -d)"
    unzip -o -q {{ $pico8zip }} -d "$PICO8_DIR"
    # mv onto an existing PICO-8.app fails with "Directory not empty"
    sudo rm -rf /Applications/PICO-8.app
    mv "$PICO8_DIR/pico-8/PICO-8.app" /Applications/
    # rm -f + truncating tee, as in install_neovim: `tee -a` wrote a second
    # shebang and a second exec line, so `pico8` launched PICO-8 twice in a row.
    sudo rm -f /usr/local/bin/pico8
    sudo tee /usr/local/bin/pico8 > /dev/null <<EOF
#!/usr/bin/env bash
/Applications/PICO-8.app/Contents/MacOS/pico8 "\$@"
EOF
    sudo chmod a+x /usr/local/bin/pico8
  {{- else if (eq .chezmoi.os "linux") }}
    sudo unzip -o -q {{ $pico8zip }} -d /usr/lib
    sudo chmod a+x /usr/lib/pico-8/pico8
    sudo rm -f /usr/local/bin/pico8
    sudo ln -s /usr/lib/pico-8/pico8 /usr/local/bin/pico8
  {{- end }}

  # Setup the cart & save data directories
  mkdir -p {{ .chezmoi.homeDir }}/dev/pico-8/carts
  mkdir -p {{ .chezmoi.homeDir }}/dev/pico-8/cdata
  {{- end }}
)
optional_runner install_pico8
{{- end }}

